<% 
    // ==============================================================
    // 100% DYNAMIC SSR SEO: Detail Galeri Dokumentasi
    // ==============================================================
    let page = 'galeri';
    let albumTitleClean = typeof album !== 'undefined' && album ? album.title : 'Galeri Kegiatan';
    let pageTitle = 'Galeri: ' + albumTitleClean;
    let pageDescription = `Dokumentasi dan arsip foto kegiatan ${albumTitleClean} HMI Komisariat Kedokteran Gigi UMI pada ${typeof album !== 'undefined' && album && album.date ? album.date : ''}.`;
    let pageImage = typeof album !== 'undefined' && album && album.cover ? album.cover : '/img/logo-hmikomkgumi.png';
    let baseUrl = "https://www.hmikomkgumi.xyz";

    // DYNAMIC IMAGEOBJECT GENERATOR
    let imageNodes = [];
    if (typeof album !== 'undefined' && album) {
        if (album.cover) {
            let coverUrl = album.cover.startsWith('http') ? album.cover : baseUrl + (album.cover.startsWith('/') ? '' : '/') + album.cover;
            imageNodes.push({
                "@type": "ImageObject",
                "url": coverUrl,
                "name": "Cover: " + album.title
            });
        }
        if (album.photos && album.photos.length > 0) {
            album.photos.forEach((p, index) => {
                let pUrl = typeof p === 'string' ? p : (p && p.url);
                if(pUrl) {
                    let absPhotoUrl = pUrl.startsWith('http') ? pUrl : baseUrl + (pUrl.startsWith('/') ? '' : '/') + pUrl;
                    imageNodes.push({
                        "@type": "ImageObject",
                        "url": absPhotoUrl,
                        "name": album.title + " - Foto " + (index + 1)
                    });
                }
            });
        }
    }
%>
<%- include('partials/header', { page: page, album: album, pageTitle: pageTitle, pageDescription: pageDescription, pageImage: pageImage }) %>

<!-- ==============================================================
     SMART GUARD: Mencegah Error jika Album tidak ditemukan
============================================================== -->
<% if (typeof album !== 'undefined' && album) { %>

<!-- ==============================================================
     GOLD STANDARD GSC: IMAGEGALLERY SCHEMA.ORG (@graph)
============================================================== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ImageGallery",
      "@id": "<%= baseUrl %>/galeri/<%= album.id || '' %>/#webpage",
      "url": "<%= baseUrl %>/galeri/<%= album.id || '' %>",
      "name": "<%= pageTitle.replace(/"/g, '\\"') %>",
      "description": "<%= pageDescription.replace(/"/g, '\\"') %>",
      "inLanguage": ["id-ID", "en-US"],
      "isPartOf": { "@id": "<%= baseUrl %>/#website" },
      "publisher": { "@id": "<%= baseUrl %>/#organization" },
      "datePublished": "<%= album.date || '' %>",
      "image": <%- JSON.stringify(imageNodes) %>
    }
  ]
}
</script>

<!-- ==============================================================
     EXPERT SEO MICRODATA (SCHEMA.ORG)
     Fallback & Deklarasi Inline untuk Robot Crawler Lama
============================================================== -->
<article itemscope itemtype="https://schema.org/ImageGallery">

    <!-- Meta tersembunyi bilingual untuk bot SEO (Invisible to Users) -->
    <div style="display: none;" aria-hidden="true">
        <h2>Photo Gallery: <%= album.title %></h2>
        <p>Explore the photo gallery and event documentation for <%= album.title %>. Capturing moments of HMI Dentistry Commissariat UMI.</p>
    </div>

    <header class="container" style="text-align:center; margin-bottom:40px; border-bottom:1px solid var(--theme-glass-border); padding-bottom:30px;">
        <a href="/galeri" style="color: var(--theme-primary); display:inline-flex; align-items:center; gap:6px; margin-bottom:20px; font-weight:700; transition:0.3s ease;">
            <i data-lucide="arrow-left" style="width:18px;"></i> Kembali ke Galeri
        </a>
        
        <h1 itemprop="headline" style="font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 10px; color: var(--theme-heading); font-weight: 800;"><%= album.title || 'Detail Galeri' %></h1>
        <p class="text-muted" style="display:inline-flex; align-items:center; gap:5px; font-size: 1rem;">
            <i data-lucide="calendar" style="width:16px;"></i> 
            <time itemprop="datePublished" datetime="<%= album.date || '' %>"><%= album.date || '-' %></time>
        </p>
    </header>

    <!-- ==============================================================
         UPGRADE UI & SEO: ImageObject Microdata pada setiap gambar
    ============================================================== -->
    <div class="gallery-detail-grid container">
        <!-- Foto Cover Utama -->
        <% if (album.cover) { %>
        <figure class="gallery-detail-item gallery-clickable" onclick="openLightbox(0)" itemprop="image" itemscope itemtype="https://schema.org/ImageObject" style="margin:0;">
            <img itemprop="contentUrl" src="<%= album.cover %>" alt="Cover: <%= album.title %>" onerror="this.src='/img/logo-hmikomkgumi.png'">
            <meta itemprop="name" content="Cover: <%= album.title %>">
        </figure>
        <% } %>
        
        <!-- Render Foto-Foto Tambahan -->
        <% if(album.photos && album.photos.length > 0) { %>
            <% album.photos.forEach((photo, index) => { %>
                <figure class="gallery-detail-item gallery-clickable" data-index="<%= album.cover ? index + 1 : index %>" onclick="openLightbox(Number(this.dataset.index))" itemprop="image" itemscope itemtype="https://schema.org/ImageObject" style="margin:0;">
                    <img itemprop="contentUrl" src="<%= photo.url %>" alt="Dokumentasi <%= album.title %> - <%= index + 1 %>" onerror="this.src='/img/logo-hmikomkgumi.png'">
                    <meta itemprop="name" content="Dokumentasi <%= index + 1 %>">
                </figure>
            <% }) %>
        <% } %>
    </div>

</article> <!-- MENGAKHIRI TAG SCHEMA IMAGE GALLERY -->

<!-- =======================================================
     LIGHTBOX FULLSCREEN OVERLAY (UI di main.css)
======================================================== -->
<div id="lightboxOverlay" class="lightbox-overlay">
    <div class="lightbox-header">
        <div class="lightbox-counter" id="lightboxCounter">1 / 1</div>
        <div class="lightbox-actions">
            <!-- Tombol Download -->
            <a id="lightboxDownload" href="#" download="HMI_KomKGUMI_Galeri" title="Download Gambar">
                <i data-lucide="download" style="width:24px; height:24px;"></i>
            </a>
            <!-- Tombol Tutup -->
            <button onclick="closeLightbox()" title="Tutup">
                <i data-lucide="x" style="width:28px; height:28px;"></i>
            </button>
        </div>
    </div>
    
    <!-- Tombol Prev -->
    <button class="lightbox-nav prev" onclick="changeLightboxImage(-1)">
        <i data-lucide="chevron-left" style="width:24px; height:24px;"></i>
    </button>
    
    <!-- Gambar Fullscreen (HD) -->
    <div class="lightbox-img-wrapper" id="lightboxImgWrapper">
        <img id="lightboxImg" src="" alt="Fullscreen Galeri">
    </div>

    <!-- Tombol Next -->
    <button class="lightbox-nav next" onclick="changeLightboxImage(1)">
        <i data-lucide="chevron-right" style="width:24px; height:24px;"></i>
    </button>
</div>

<!-- ==============================================================
     LOGIKA LIGHTBOX ANTI-CRASH (Bebas Error 500 & Syntax Error)
============================================================== -->
<script id="albumDataJson" type="application/json"><%- typeof album !== 'undefined' && album ? JSON.stringify(album).replace(/</g, '\\u003c') : '{}' %></script>

<script>
    let albumData = {};
    try {
        const rawAlbum = document.getElementById('albumDataJson').textContent;
        if (rawAlbum && rawAlbum.trim() !== '' && !rawAlbum.includes('<' + '%')) {
            albumData = JSON.parse(rawAlbum);
        }
    } catch(e) {
        console.warn('Parsing EJS data failed:', e);
    }

    const lightboxImages = [];

    if (albumData.cover) {
        lightboxImages.push(albumData.cover);
    }
    if (albumData.photos && albumData.photos.length > 0) {
        albumData.photos.forEach(photo => {
            if (photo && photo.url) lightboxImages.push(photo.url);
        });
    }

    let currentLightboxIndex = 0;
    const overlay = document.getElementById('lightboxOverlay');
    const imgEl = document.getElementById('lightboxImg');
    const counterEl = document.getElementById('lightboxCounter');
    const downloadEl = document.getElementById('lightboxDownload');

    function openLightbox(index) {
        if (lightboxImages.length === 0) return;
        currentLightboxIndex = index;
        updateLightbox();
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden'; 
    }

    function closeLightbox() {
        overlay.classList.remove('active');
        document.body.style.overflow = 'auto'; 
    }

    function changeLightboxImage(direction) {
        if (lightboxImages.length === 0) return;
        currentLightboxIndex += direction;
        
        if (currentLightboxIndex < 0) {
            currentLightboxIndex = lightboxImages.length - 1;
        } else if (currentLightboxIndex >= lightboxImages.length) {
            currentLightboxIndex = 0;
        }
        
        updateLightbox();
    }

    function updateLightbox() {
        if (lightboxImages.length === 0) return;
        const imageUrl = lightboxImages[currentLightboxIndex];
        
        imgEl.style.opacity = 0;
        setTimeout(() => {
            imgEl.src = imageUrl;
            imgEl.style.opacity = 1;
        }, 150);

        counterEl.innerText = (currentLightboxIndex + 1) + " / " + lightboxImages.length;
        
        const safeTitle = (albumData.title || "Galeri").toString().replace(/[^a-zA-Z0-9]/g, '_');
        downloadEl.href = imageUrl;
        downloadEl.download = "Galeri_HMI_" + safeTitle + "_" + (currentLightboxIndex + 1);
    }

    document.getElementById('lightboxImgWrapper').addEventListener('click', function(e) {
        if (e.target === this) {
            closeLightbox();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (!overlay || !overlay.classList.contains('active')) return;
        if (e.key === "ArrowLeft") changeLightboxImage(-1);
        else if (e.key === "ArrowRight") changeLightboxImage(1);
        else if (e.key === "Escape") closeLightbox();
    });
</script>
<script src="/js/protect-devtools.js" defer></script>

