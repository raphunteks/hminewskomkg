<% 
    // ==============================================================
    // FIX ERROR 500 (SERVER CRASH): 
    // Injeksi variabel SEO secara eksplisit sebelum memanggil header
    // Mencegah ReferenceError pada fitur Expert SEO (Breadcrumbs)
    // ==============================================================
    let pageTitle = "Data Anggota";
    let pageDescription = "Database keanggotaan terupdate HMI Komisariat Kedokteran Gigi UMI. Akses arsip data kader dan pengurus komisariat.";
    
    // Konstanta Base URL untuk Expert SEO PDF Indexing
    const seoBaseUrl = 'https://www.hmikomkgumi.xyz';
%>
<%- include('partials/header', { pageTitle: pageTitle, pageDescription: pageDescription }) %>

<!-- ==============================================================
     SUPER BIG UPGRADE SEO: DYNAMIC META TAGS INJECTION
     Memastikan Judul, Deskripsi, Gambar & Canonical Terindeks Sempurna
============================================================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const metaTags = [
        { name: "description", content: "<%= pageDescription %>" },
        { name: "keywords", content: "Data Anggota HMI, Database Kader HMI, HMI KomKG UMI, Kedokteran Gigi UMI, Mahasiswa FKG UMI, Pengurus HMI Makassar, Yakusa" },
        { name: "author", content: "Admin HMI KomKG UMI" },
        { name: "robots", content: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" },
        
        // Open Graph (WhatsApp, FB, IG)
        { property: "og:title", content: "<%= pageTitle %> | HMI KomKG UMI" },
        { property: "og:description", content: "<%= pageDescription %>" },
        { property: "og:type", content: "website" },
        { property: "og:url", content: "<%= seoBaseUrl %>/data-anggota" },
        { property: "og:image", content: "<%= seoBaseUrl %>/img/logo.png" },
        { property: "og:site_name", content: "HMI KomKG UMI" },
        
        // Twitter Cards
        { property: "twitter:card", content: "summary_large_image" },
        { property: "twitter:title", content: "<%= pageTitle %> | HMI KomKG UMI" },
        { property: "twitter:description", content: "<%= pageDescription %>" },
        { property: "twitter:image", content: "<%= seoBaseUrl %>/img/logo.png" }
    ];

    // Injeksi Link Canonical ke Google Search Console
    let canonical = document.createElement('link');
    canonical.rel = 'canonical';
    canonical.href = "<%= seoBaseUrl %>/data-anggota";
    document.head.appendChild(canonical);

    // Injeksi Meta Tags ke dalam Head
    metaTags.forEach(tag => {
        let selector = tag.name ? `meta[name="${tag.name}"]` : `meta[property="${tag.property}"]`;
        if (!document.head.querySelector(selector)) {
            let el = document.createElement('meta');
            if(tag.name) el.name = tag.name;
            if(tag.property) el.setAttribute('property', tag.property);
            el.content = tag.content;
            document.head.appendChild(el);
        }
    });
});
</script>

<style>
    /* Styling Frame Bezel & Multi-Page Continuous Canvas */
    .native-pdf-bezel-frame {
        position: relative;
        width: 100%;
        height: 82vh;
        min-height: 600px;
        background: #2a2d32;
        border-radius: 20px;
        overflow: hidden;
        border: 2px solid rgba(74, 222, 128, 0.4);
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.45);
    }

    .pdf-continuous-container {
        width: 100%;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        padding: 20px 10px 90px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        box-sizing: border-box;
    }

    /* Kustomisasi Scrollbar agar persis Gambar 2 */
    .pdf-continuous-container::-webkit-scrollbar {
        width: 8px;
    }
    .pdf-continuous-container::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.25);
    }
    .pdf-continuous-container::-webkit-scrollbar-thumb {
        background: #4ade80;
        border-radius: 4px;
    }

    .pdf-page-canvas {
        display: block;
        max-width: 98%;
        height: auto !important;
        background: #ffffff;
        border-radius: 6px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
    }

    /* Tombol Floating Buka Full PDF */
    .btn-buka-full-pdf {
        position: absolute;
        bottom: 22px;
        right: 22px;
        z-index: 80;
        background: #84cc16;
        background: linear-gradient(135deg, #a3e635 0%, #4ade80 100%);
        color: #052e16;
        font-weight: 800;
        font-size: 0.88rem;
        padding: 12px 20px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        border: 2px solid #14532d;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-buka-full-pdf:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(74, 222, 128, 0.4);
    }

    .pdf-loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #4ade80;
        font-size: 0.95rem;
        gap: 12px;
    }

    .pdf-pulse-loader {
        width: 42px;
        height: 42px;
        border: 4px solid rgba(74, 222, 128, 0.2);
        border-top-color: #4ade80;
        border-radius: 50%;
        animation: pdfSpin 0.9s linear infinite;
    }

    @keyframes pdfSpin {
        to { transform: rotate(360deg); }
    }

    /* Views Analytics Glassmorphism Card (Views Today, This Week, Total Views) */
    .views-analytics-card {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 35px;
        padding: 20px 24px;
        background: rgba(22, 27, 34, 0.78);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(74, 222, 128, 0.28);
        border-radius: 18px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
        box-sizing: border-box;
    }

    .views-analytics-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: 14px;
        background: rgba(15, 23, 42, 0.55);
        border: 1px solid rgba(74, 222, 128, 0.15);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .views-analytics-item:hover {
        transform: translateY(-2px);
        border-color: rgba(74, 222, 128, 0.45);
        box-shadow: 0 8px 20px rgba(74, 222, 128, 0.12);
    }

    .views-analytics-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(74, 222, 128, 0.15);
        color: #4ade80;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .views-analytics-info {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .views-analytics-label {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .views-analytics-value {
        font-size: 1.35rem;
        color: #f8fafc;
        font-weight: 800;
        line-height: 1.2;
        margin-top: 2px;
        font-family: 'JetBrains Mono', monospace;
    }

    @media (max-width: 680px) {
        .views-analytics-card {
            grid-template-columns: 1fr;
            gap: 12px;
            padding: 16px;
        }
    }
</style>

<!-- Script Resmi Mozilla PDF.js Engine -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<div style="max-width: 1000px; margin: 0 auto; text-align: center; margin-bottom: 50px;">
    <h2 style="color:#4ade80; margin-bottom:15px; font-weight:bold; font-size: clamp(1.8rem, 4vw, 2.3rem);">Data Anggota HMI KomKG-UMI</h2>
    <p class="text-muted" style="margin-bottom: 35px; font-size: 1rem;">Database keanggotaan terupdate. Pilih dan baca langsung dokumen PDF di bawah ini.</p>
    
    <% 
    // ==============================================================
    // UPGRADE LOGIC (SMART FALLBACK & CRUD INTEGRATION): 
    // ==============================================================
    let pdfList = (typeof dataAnggota !== 'undefined' && dataAnggota && dataAnggota.length > 0) 
                  ? dataAnggota 
                  : [{ title: "Data Anggota Komisariat (Default)", file: "/data-anggota.pdf", date: "Default" }];

    let firstPdfAbsolute = pdfList[0].file.startsWith('http') 
