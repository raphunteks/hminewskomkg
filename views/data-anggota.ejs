                <span class="views-analytics-label">Total Views</span>
                <span class="views-analytics-value" id="valViewsTotal"><%= Number(vTotal).toLocaleString('id-ID') %></span>
            </div>
        </div>
    </div>
</div>

<script>
    // Konfigurasi Worker Mozilla PDF.js
    if (typeof pdfjsLib !== 'undefined') {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    let activePdfDoc = null;

    // Fungsi Render Multi-Halaman Beruntun (Scrollable Tanpa Terpotong)
    async function renderContinuousPdf(pdfUrl) {
        const container = document.getElementById('pdf-scroll-container');
        if (!container) return;

        container.innerHTML = `
            <div class="pdf-loading-spinner">
                <div class="pdf-pulse-loader"></div>
                <span>Memuat seluruh halaman dokumen...</span>
            </div>
        `;

        try {
            const loadingTask = pdfjsLib.getDocument({
                url: pdfUrl,
                cMapUrl: 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/cmaps/',
                cMapPacked: true
            });

            activePdfDoc = await loadingTask.promise;
            container.innerHTML = ''; // Bersihkan loader setelah siap

            const totalPages = activePdfDoc.numPages;
            const containerWidth = container.clientWidth - 30;

            for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
                const page = await activePdfDoc.getPage(pageNumber);

                // Hitung skala otomatis agar pas dengan lebar layar HP / Desktop
                const defaultViewport = page.getViewport({ scale: 1.0 });
                const calculatedScale = containerWidth > 0 ? (containerWidth / defaultViewport.width) : 1.2;
                const finalScale = Math.min(Math.max(calculatedScale, 0.75), 2.2);
                const viewport = page.getViewport({ scale: finalScale });

                // Render Canvas dengan Dukungan Layar Sentuh Retina / HiDPI
                const canvas = document.createElement('canvas');
                canvas.className = 'pdf-page-canvas';
                canvas.id = `pdf-page-${pageNumber}`;

                const pixelRatio = window.devicePixelRatio || 1;
                canvas.width = Math.floor(viewport.width * pixelRatio);
                canvas.height = Math.floor(viewport.height * pixelRatio);
                canvas.style.width = Math.floor(viewport.width) + "px";
                canvas.style.height = Math.floor(viewport.height) + "px";

                const ctx = canvas.getContext('2d', { alpha: false });
                const renderContext = {
                    canvasContext: ctx,
                    transform: pixelRatio !== 1 ? [pixelRatio, 0, 0, pixelRatio, 0, 0] : null,
                    viewport: viewport
                };

                container.appendChild(canvas);
                await page.render(renderContext).promise;
            }
        } catch (err) {
            console.warn('PDF.js render fallback, beralih ke native frame:', err);
            container.innerHTML = `
                <iframe src="${pdfUrl}#view=FitH" style="width:100%; height:100%; border:none;" title="PDF Preview">
                    Browser Anda tidak mendukung preview. Silakan buka PDF secara langsung.
                </iframe>
            `;
        }
    }

    // Fungsi Penggantian Dokumen via Tab
    function changePdf(src, btn, absoluteUrl) {
        // 1. Render ulang dokumen PDF yang dipilih
        renderContinuousPdf(src);
        
        // 2. Perbarui tautan tombol floating Buka Full PDF
        const btnFull = document.getElementById('btnBukaFullPdf');
        if (btnFull) {
            btnFull.href = absoluteUrl;
        }

        // 3. Animasi status tombol tab aktif
        document.querySelectorAll('.tab-pdf-btn').forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-secondary');
        });
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-primary');
    }

    // Jalankan render awal saat dokumen dimuat
    document.addEventListener('DOMContentLoaded', () => {
        renderContinuousPdf('<%= pdfList[0].file %>');
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
