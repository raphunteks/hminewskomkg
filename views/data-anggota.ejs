    <p class="text-muted" style="text-align:center; margin-top:15px; font-size:0.85rem;">
        <i data-lucide="info" style="width:15px; display:inline; vertical-align:text-bottom;"></i> Geser ke bawah untuk membaca seluruh halaman dokumen atau sentuh tombol <strong>BUKA FULL PDF</strong> untuk membuka dokumen asli.
    </p>

    <!-- ==============================================================
         WIDGET STATISTIK PENGUNJUNG (VIEWS TODAY, THIS WEEK, TOTAL VIEWS)
    ============================================================== -->
    <% 
        let vToday = (typeof viewsToday !== 'undefined' && viewsToday !== null) ? viewsToday : ((typeof stats !== 'undefined' && stats && stats.today) ? stats.today : 0);
        let vWeek = (typeof viewsWeek !== 'undefined' && viewsWeek !== null) ? viewsWeek : ((typeof stats !== 'undefined' && stats && stats.week) ? stats.week : 0);
        let vTotal = (typeof totalViews !== 'undefined' && totalViews !== null) ? totalViews : ((typeof stats !== 'undefined' && stats && stats.total) ? stats.total : 0);
    %>
    <div class="views-analytics-card">
        <div class="views-analytics-item">
