           rel="noopener noreferrer" 
           class="btn-buka-full-pdf" 
           title="Buka PDF di Tab Baru / Layar Penuh">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>BUKA FULL PDF</span>
        </a>
    </div>
    
    <p class="text-muted" style="text-align:center; margin-top:15px; font-size:0.85rem;">
        <i data-lucide="info" style="width:15px; display:inline; vertical-align:text-bottom;"></i> Dokumen mendukung gulir vertikal penuh di ponsel, atau klik tombol <strong>BUKA FULL PDF</strong> untuk membuka di tab baru.
    </p>

    <!-- ==============================================================
         SUPER BIG UPGRADE: DASHBOARD ANALYTICS WIDGET
         (STRUKTUR, KELAS & TAMPILAN PERSIS INDEX.EJS / GAMBAR 1)
    ============================================================== -->
    <section class="analytics-section" aria-label="Statistik Kunjungan Website" style="margin-top: 50px;">
        <div class="analytics-grid">
            <div class="analytic-card">
                <h4 class="analytic-title">VIEWS TODAY</h4>
                <div class="analytic-value stat-today" id="val-today">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">THIS WEEK</h4>
                <div class="analytic-value stat-week" id="val-week">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">TOTAL VIEWS</h4>
                <div class="analytic-value stat-total" id="val-total">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ==============================================================
     LOGIKA ENGINE RENDERING MOZILLA PDF.JS (BLOCK CONTEXT & NON-FLAT SCROLL)
============================================================== -->
<script>
    if (typeof pdfjsLib !== 'undefined') {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    let activePdfTask = null;

    async function renderContinuousPdf(pdfUrl) {
        const viewport = document.getElementById('pdfRenderViewport');
        const loader = document.getElementById('pdfLoadingIndicator');
        if (!viewport) return;

        if (loader) {
            loader.innerHTML = `
                <i data-lucide="loader-2" class="spin-icon" style="width:30px; height:30px;"></i>
                <span>Menyiapkan Dokumen PDF...</span>
            `;
            loader.style.display = 'flex';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        // Bersihkan halaman lama
        viewport.innerHTML = '';

        try {
            if (activePdfTask) {
                try { activePdfTask.destroy(); } catch(e) {}
            }

            const loadingTask = pdfjsLib.getDocument(pdfUrl);
            activePdfTask = loadingTask;
            const pdfDoc = await loadingTask.promise;

            if (loader) loader.style.display = 'none';

            // Hitung lebar area pandang
            const containerWidth = viewport.clientWidth > 0 ? viewport.clientWidth : window.innerWidth;
            const targetWidth = Math.max(300, Math.min(850, containerWidth - 24));
            const dpr = Math.min(window.devicePixelRatio || 2, 2.5);

            for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
                const page = await pdfDoc.getPage(pageNum);
                const unscaledViewport = page.getViewport({ scale: 1.0 });

                // Skala proporsional penuh per halaman
                const fitScale = targetWidth / unscaledViewport.width;
                const renderViewport = page.getViewport({ scale: fitScale * dpr });

                const cssWidth = Math.floor(unscaledViewport.width * fitScale);
                const cssHeight = Math.floor(unscaledViewport.height * fitScale);

                // Pembungkus halaman bergaya lembaran kertas block
                const pageWrapper = document.createElement('div');
                pageWrapper.className = 'pdf-page-wrapper';
                pageWrapper.style.width = `${cssWidth}px`;
                pageWrapper.style.height = `${cssHeight}px`;

                const canvas = document.createElement('canvas');
                const context = canvas.getContext('2d', { alpha: false });

                canvas.width = Math.floor(renderViewport.width);
                canvas.height = Math.floor(renderViewport.height);
                canvas.style.width = `${cssWidth}px`;
                canvas.style.height = `${cssHeight}px`;

                pageWrapper.appendChild(canvas);
                viewport.appendChild(pageWrapper);

                const renderContext = {
                    canvasContext: context,
                    viewport: renderViewport
                };

                await page.render(renderContext).promise;
            }
        } catch (error) {
            console.error('PDF.js render error:', error);
            if (loader) {
                loader.innerHTML = `
                    <div style="color:#f87171; text-align:center; padding:20px;">
                        <p style="margin-bottom:12px;">Pratinjau langsung tidak dapat dimuat di peramban ini.</p>
                        <a href="${pdfUrl}" target="_blank" class="btn-buka-full-pdf" style="position:static; display:inline-flex;">
                            Buka / Unduh File PDF
                        </a>
                    </div>
                `;
                loader.style.display = 'flex';
            }
        }
    }

    function changePdf(src, btn, absoluteUrl) {
        // 1. Perbarui link floating button
        const btnFull = document.getElementById('btnBukaFullPdf');
        if (btnFull) btnFull.href = absoluteUrl;

        // 2. Render ulang semua halaman PDF
        renderContinuousPdf(src);

        // 3. Status tombol tab aktif
        document.querySelectorAll('.tab-pdf-btn').forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-secondary');
        });
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-primary');
    }
</script>

<!-- ==============================================================
     SCRIPT PENGGERAK API GOOGLE APPS SCRIPT (PERSIS INDEX.EJS)
============================================================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    // Render PDF pertama kali
    renderContinuousPdf("<%= pdfList[0].file %>");

    const GAS_URL = "https://script.google.com/macros/s/AKfycbw8MA9YGFK3SIAXhIZAF9m1J4eOGf9LGQD-j4xXjvVSaQ826JrqeEKApPcKJWfJxw/exec";

    let currentStats = { today: -1, week: -1, total: -1 };

    function animateValue(obj, start, end, duration) {
        if (start === end) return; 
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString('id-ID'); 
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }

    function updateUI(data, speed) {
        if(data.today !== undefined && data.today !== currentStats.today) {
            animateValue(document.getElementById('val-today'), Math.max(0, currentStats.today), data.today, speed);
            currentStats.today = data.today;
        }
        if(data.week !== undefined && data.week !== currentStats.week) {
            animateValue(document.getElementById('val-week'), Math.max(0, currentStats.week), data.week, speed);
            currentStats.week = data.week;
        }
        if(data.total !== undefined && data.total !== currentStats.total) {
            animateValue(document.getElementById('val-total'), Math.max(0, currentStats.total), data.total, speed);
            currentStats.total = data.total;
        }
    }

    async function fastFetchData() {
        try {
            const response = await fetch(GAS_URL + "?t=" + new Date().getTime());
            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                updateUI(data, 1000);
            } catch (jsonErr) {
                console.warn("GAS Redirect/CORS Error, menggunakan fallback UI.");
                setFallbackUI();
            }
        } catch (err) {
            console.warn("Koneksi ke GAS lambat/gagal.", err);
        }
    }

    async function recordVisitPost() {
        try {
            const ipResponse = await fetch('https://api.ipify.org?format=json');
            const ipData = await ipResponse.json();
            const clientIP = ipData.ip || 'Unknown';

            const response = await fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({ ip: clientIP })
            });

            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                if(data.status === "success") {
                    updateUI(data, 500);
                }
            } catch (jsonErr) {
                // Berjalan secara silent
            }
        } catch (error) {
            // Berjalan secara silent
        }
    }

    function setFallbackUI() {
        if(currentStats.today === -1) {
            document.getElementById('val-today').innerHTML = "-";
            document.getElementById('val-week').innerHTML = "-";
            document.getElementById('val-total').innerHTML = "-";
        }
    }

    fastFetchData();

    setTimeout(() => { 
        recordVisitPost(); 
    }, 2000);

    if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>
