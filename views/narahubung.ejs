    // FIX ERROR 500 & SEO BREADCRUMB: 
    // Injeksi variabel SEO secara eksplisit untuk Halaman Narahubung
    // ==============================================================
    let page = 'narahubung';
    let pageTitle = 'Narahubung & Kontak Resmi';
    let pageDescription = 'Hubungi HMI Komisariat Kedokteran Gigi UMI. Layanan informasi kegiatan, pengajuan kerjasama, surat undangan resmi, dan alamat sekretariat.';
    const seoBaseUrl = 'https://hmikomkgumi.xyz';

    const safeSettings = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {};
    const contactAddress = safeSettings.contactAddress || "Jl. Pajonga Dg. Ngalle No. 27 A, Pa'batong, Kec. Mamajang, Kota Makassar, Sulawesi Selatan";
    const contactEmail = safeSettings.contactEmail || "hmikomkedokgigiumi.190120@gmail.com";
    const contactWa = safeSettings.contactWa || "+62 853-3892-2586";
    const contactWaName = safeSettings.contactWaName || "M. Aksa A";
    const contactMaps = safeSettings.contactMaps || safeSettings.mapsEmbed || '<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1986.8184522616118!2d119.41377772579179!3d-5.161978821534889!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dbf1d606370a527%3A0xdb175c222d9d580b!2sUniversitas%20Muslim%20Indonesia%2C%20Fakultas%20Kedokteran%20Gigi!5e0!3m2!1sid!2sid!4v1789058845150!5m2!1sid!2sid" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>';
%>
<%- include('partials/header', { page: page, pageTitle: pageTitle, pageDescription: pageDescription }) %>

<!-- ==============================================================
     ADVANCED JSON-LD SCHEMA.ORG (CONTACTPAGE & ORGANIZATION)
============================================================== -->
