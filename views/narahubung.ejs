<script src="/js/protect-devtools.js" defer></script>

<div class="narahubung-container">
    
    <!-- HEADER HALAMAN -->
    <header class="narahubung-header" style="text-align: center; margin-bottom: 40px;">
        <span class="badge" style="margin-bottom: 12px;">Pusat Komunikasi & Informasi</span>
        <h1 style="font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 800; margin-bottom: 10px;">Narahubung Resmi</h1>
        <p class="text-muted" style="max-width: 650px; margin: 0 auto; font-size: 1rem; line-height: 1.6;">
            Hubungi pengurus HMI Komisariat Kedokteran Gigi UMI untuk keperluan administrasi, undangan kemahasiswaan, kemitraan, atau konsultasi seputar komisariat.
        </p>
    </header>

    <!-- GRID UTAMA 2 KOLOM (PERSIS GAMBAR 4) -->
    <div class="narahubung-grid">
        
        <!-- ==============================================================
             KOLOM KIRI: FORMULIR KIRIM PESAN KE DATABASE BACKEND
        ============================================================== -->
        <div class="glass narahubung-card form-side">
            <div class="card-headline">
                <span class="card-icon-emoji">✉️</span>
                <h2>Kirim Pesan Cepat</h2>
            </div>

            <!-- Banner Notifikasi Status Pengiriman -->
            <div id="narahubungAlertBox" style="display: none; margin-bottom: 20px;"></div>
            
            <form id="formNarahubung" onsubmit="handleFormSubmit(event)">
                <!-- 1. Nama Lengkap / Instansi -->
                <div class="form-group">
                    <label for="senderName">Nama Lengkap / Instansi <span class="required-star" style="color:#ef4444;">*</span></label>
                    <input type="text" id="senderName" name="name" class="input-control" placeholder="Masukkan nama atau instansi Anda..." required>
                </div>

                <!-- 2. Metode Balasan (Toggle WA / Email) -->
                <div class="form-group">
                    <label>Metode Balasan <span class="required-star" style="color:#ef4444;">*</span></label>
                    <div class="toggle-reply-method">
                        <button type="button" class="reply-tab-btn active" id="btnMethodWA" onclick="switchReplyMethod('wa')">
                            <i data-lucide="message-circle" style="width: 16px;"></i> WhatsApp
                        </button>
                        <button type="button" class="reply-tab-btn" id="btnMethodEmail" onclick="switchReplyMethod('email')">
                            <i data-lucide="mail" style="width: 16px;"></i> Email
                        </button>
                    </div>
                </div>

                <!-- Input Kontak Dinamis (WhatsApp / Email) -->
                <div class="form-group" id="groupInputWA">
                    <label for="senderWA">Nomor WhatsApp <span class="required-star" style="color:#ef4444;">*</span></label>
                    <input type="tel" id="senderWA" class="input-control" placeholder="Nomor WA (Contoh: 0812xxxx)" required>
                </div>

                <div class="form-group" id="groupInputEmail" style="display: none;">
                    <label for="senderEmail">Alamat Email <span class="required-star" style="color:#ef4444;">*</span></label>
                    <input type="email" id="senderEmail" class="input-control" placeholder="Alamat Email (Contoh: nama@domain.com)">
                </div>

                <!-- 3. Tujuan Pesan -->
                <div class="form-group">
                    <label for="messageSubject">Tujuan Pesan <span class="required-star" style="color:#ef4444;">*</span></label>
                    <select id="messageSubject" name="subject" class="input-control" required>
                        <option value="" disabled selected>-- Pilih Tujuan Pesan --</option>
                        <option value="Permohonan Kerjasama & Kemitraan">Permohonan Kerjasama & Kemitraan</option>
                        <option value="Undangan Kegiatan / Pelatihan">Undangan Kegiatan / Pelatihan</option>
                        <option value="Informasi Basic Training (LK I)">Informasi Basic Training (LK I)</option>
                        <option value="Administrasi & Surat Menyurat">Administrasi & Surat Menyurat</option>
                        <option value="Aspirasi & Konsultasi Mahasiswa">Aspirasi & Konsultasi Mahasiswa</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>

                <!-- 4. Dokumen Pendukung (Opsional) -->
                <div class="form-group">
                    <label for="supportDoc">Dokumen Pendukung (Opsional)</label>
                    <div class="custom-file-upload">
                        <input type="file" id="supportDoc" name="supportDoc" class="file-hidden-input" accept=".pdf,image/*" onchange="updateFileName(this)">
                        <button type="button" class="btn-browse-file" onclick="document.getElementById('supportDoc').click()">Pilih File</button>
                        <span id="fileNameLabel" class="file-name-label">Tidak ada file yang dipilih</span>
                    </div>
                    <small class="text-muted" style="font-size: 0.75rem; margin-top: 4px; display: block;">Format PDF atau Gambar (Maks. 5MB)</small>
                </div>

                <!-- 5. Isi Pesan -->
                <div class="form-group">
                    <label for="messageBody">Isi Pesan <span class="required-star" style="color:#ef4444;">*</span></label>
                    <textarea id="messageBody" name="message" class="input-control" rows="4" placeholder="Jelaskan maksud pesan atau penawaran Anda secara detail..." required></textarea>
                </div>

                <!-- Tombol Submit ke Database Backend -->
                <button type="submit" class="btn-submit-message" id="btnSubmitPesan">
                    <span id="btnSubmitText">Kirim Pesan Sekarang</span>
                    <i data-lucide="send" id="btnSubmitIcon" style="width: 18px;"></i>
                </button>
            </form>
        </div>

        <!-- ==============================================================
             KOLOM KANAN: LOKASI & KONTAK RESMI + PETA EMBED
        ============================================================== -->
        <div class="narahubung-side-info">
            
            <div class="glass narahubung-card">
                <div class="card-headline">
                    <span class="card-icon-emoji">📍</span>
                    <h2>Lokasi & Kontak Resmi</h2>
                </div>

                <div class="contact-info-list">
                    
                    <!-- 1. Sekretariat Utama -->
                    <div class="contact-item-card">
                        <div class="contact-icon-box">
                            <i data-lucide="building-2"></i>
                        </div>
                        <div class="contact-text-wrap">
                            <h4>Sekretariat Utama</h4>
                            <p><%= contactAddress %></p>
                        </div>
                    </div>

                    <!-- 2. Email Resmi -->
                    <div class="contact-item-card">
                        <div class="contact-icon-box">
                            <i data-lucide="mail"></i>
                        </div>
                        <div class="contact-text-wrap">
                            <h4>Email Resmi</h4>
                            <a href="mailto:<%= contactEmail %>" class="contact-link" title="Kirim Email">
                                <%= contactEmail %>
                            </a>
                        </div>
                    </div>

                    <!-- 3. Penerangan (WhatsApp) -->
                    <div class="contact-item-card">
                        <div class="contact-icon-box wa-box">
                            <i data-lucide="phone"></i>
                        </div>
                        <div class="contact-text-wrap">
                            <h4>Infocom / Penerangan (WhatsApp)</h4>
                            <% 
                                let cleanWaNumber = contactWa.replace(/[^0-9]/g, '');
                            %>
                            <a href="https://api.whatsapp.com/send/?phone=<%= cleanWaNumber %>&text=Halo%20Admin%20HMI%20KomKG%20UMI,%20saya%20ingin%20berkonsultasi&type=phone_number&app_absent=0" target="_blank" class="contact-link wa-highlight" title="Chat via WhatsApp">
                                <%= contactWa %> <span class="badge-person">(<%= contactWaName %>)</span>
                            </a>
                            <small class="contact-subhint">*Klik nomor di atas untuk langsung terhubung ke WhatsApp Admin</small>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Peta Lokasi Sekretariat / Kampus -->
            <div class="glass narahubung-card" style="margin-top: 25px;">
                <div class="card-headline">
                    <span class="card-icon-emoji">🗺️</span>
                    <h2>Peta Lokasi Kampus & Sekretariat</h2>
                </div>
                <div class="map-frame-wrapper ratio ratio-16x9">
                    <%- contactMaps %>
                </div>
            </div>

        </div>

    </div>

    <!-- ==============================================================
         SUPER BIG UPGRADE: DASHBOARD ANALYTICS WIDGET
         (STRUKTUR & CLASS PERSIS INDEX.EJS / GAMBAR 1)
    ============================================================== -->
    <section class="analytics-section" aria-label="Statistik Kunjungan Website" style="margin-top: 50px;">
        <div class="analytics-grid">
            <div class="analytic-card">
                <h4 class="analytic-title">VIEWS TODAY</h4>
                <div class="analytic-value stat-today" id="val-today">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">THIS WEEK</h4>
                <div class="analytic-value stat-week" id="val-week">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">TOTAL VIEWS</h4>
                <div class="analytic-value stat-total" id="val-total">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ==============================================================
     LOGIKA JAVASCRIPT: PENGIRIMAN AJAX KE DATABASE BACKEND
============================================================== -->
<script>
    let activeMethod = 'wa';

    function switchReplyMethod(method) {
        activeMethod = method;
        const btnWA = document.getElementById('btnMethodWA');
        const btnEmail = document.getElementById('btnMethodEmail');
        const groupWA = document.getElementById('groupInputWA');
        const groupEmail = document.getElementById('groupInputEmail');
        const inputWA = document.getElementById('senderWA');
        const inputEmail = document.getElementById('senderEmail');

        if (method === 'wa') {
            btnWA.classList.add('active');
            btnEmail.classList.remove('active');
            groupWA.style.display = 'block';
            groupEmail.style.display = 'none';
            inputWA.required = true;
            inputEmail.required = false;
        } else {
            btnEmail.classList.add('active');
            btnWA.classList.remove('active');
            groupWA.style.display = 'none';
            groupEmail.style.display = 'block';
            inputEmail.required = true;
            inputWA.required = false;
        }
    }

    function updateFileName(input) {
        const label = document.getElementById('fileNameLabel');
        if (input.files && input.files.length > 0) {
            label.innerText = input.files[0].name;
            label.style.color = '#4ade80';
        } else {
            label.innerText = 'Tidak ada file yang dipilih';
            label.style.color = '#9ca3af';
        }
    }

    // ==============================================================
    // SUBMIT DATA LANGSUNG KE BACKEND DATABASE ADMIN (/api/kirim-pesan-narahubung)
    // ==============================================================
    async function handleFormSubmit(event) {
        event.preventDefault();

        const submitBtn = document.getElementById('btnSubmitPesan');
        const submitText = document.getElementById('btnSubmitText');
        const alertBox = document.getElementById('narahubungAlertBox');

        const name = document.getElementById('senderName').value.trim();
        const contact = activeMethod === 'wa' ? document.getElementById('senderWA').value.trim() : document.getElementById('senderEmail').value.trim();
        const subject = document.getElementById('messageSubject').value;
        const message = document.getElementById('messageBody').value.trim();
        const fileInput = document.getElementById('supportDoc');

        if (!name || !contact || !subject || !message) {
            showAlert('error', 'Mohon lengkapi semua kolom wajib.');
            return;
        }

        // Siapkan Payload Multipart Form Data
        const formData = new FormData();
        formData.append('name', name);
        formData.append('method', activeMethod);
        formData.append('contact', contact);
        formData.append('subject', subject);
        formData.append('message', message);

        if (fileInput.files && fileInput.files[0]) {
            formData.append('supportDoc', fileInput.files[0]);
        }

        // Status Loading
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
        submitText.innerText = 'Mengirim Pesan ke Database...';

        try {
            const response = await fetch('/api/kirim-pesan-narahubung', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.status === 'success') {
                showAlert('success', 'Pesan Anda berhasil terkirim dan tersimpan di database admin! Pengurus HMI KomKG UMI akan segera menindaklanjuti pesan Anda.');
                
                // Reset Form
                document.getElementById('formNarahubung').reset();
                document.getElementById('fileNameLabel').innerText = 'Tidak ada file yang dipilih';
                document.getElementById('fileNameLabel').style.color = '#9ca3af';
                switchReplyMethod('wa');
            } else {
                showAlert('error', result.message || 'Gagal mengirim pesan. Silakan coba kembali.');
            }
        } catch (err) {
            console.error('Error pengiriman pesan:', err);
            showAlert('error', 'Terjadi gangguan koneksi ke server. Silakan coba sesaat lagi.');
        } finally {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitText.innerText = 'Kirim Pesan Sekarang';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
    }

    function showAlert(type, message) {
        const alertBox = document.getElementById('narahubungAlertBox');
        if (!alertBox) return;

        if (type === 'success') {
            alertBox.innerHTML = `
                <div style="background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.4); color: #4ade80; padding: 14px 18px; border-radius: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px; line-height: 1.6;">
                    <i data-lucide="check-circle-2" style="width:20px; height:20px; flex-shrink:0; margin-top:2px;"></i>
                    <span>${message}</span>
                </div>
            `;
        } else {
            alertBox.innerHTML = `
                <div style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4); color: #f87171; padding: 14px 18px; border-radius: 12px; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 10px; line-height: 1.6;">
                    <i data-lucide="alert-circle" style="width:20px; height:20px; flex-shrink:0; margin-top:2px;"></i>
                    <span>${message}</span>
                </div>
            `;
        }

        alertBox.style.display = 'block';
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Scroll halus menuju alert
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>

<!-- ==============================================================
     SCRIPT PENGGERAK API GOOGLE APPS SCRIPT (PERSIS INDEX.EJS)
============================================================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    // --- URL DEPLOYMENT GOOGLE APPS SCRIPT PERSIS INDEX.EJS ---
    const GAS_URL = "https://script.google.com/macros/s/AKfycbw8MA9YGFK3SIAXhIZAF9m1J4eOGf9LGQD-j4xXjvVSaQ826JrqeEKApPcKJWfJxw/exec";

    // Variabel state untuk mencegah update animasi berulang
    let currentStats = { today: -1, week: -1, total: -1 };

    function animateValue(obj, start, end, duration) {
        if (start === end) return; 
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString('id-ID'); 
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }

    function updateUI(data, speed) {
        if(data.today !== undefined && data.today !== currentStats.today) {
            animateValue(document.getElementById('val-today'), Math.max(0, currentStats.today), data.today, speed);
            currentStats.today = data.today;
        }
        if(data.week !== undefined && data.week !== currentStats.week) {
            animateValue(document.getElementById('val-week'), Math.max(0, currentStats.week), data.week, speed);
            currentStats.week = data.week;
        }
        if(data.total !== undefined && data.total !== currentStats.total) {
            animateValue(document.getElementById('val-total'), Math.max(0, currentStats.total), data.total, speed);
            currentStats.total = data.total;
        }
    }

    // TAHAP 1: FAST FETCH (Memuat data dalam milidetik)
    async function fastFetchData() {
        try {
            // Parameter ?t= mencegah HP melakukan Cache angka lama
            const response = await fetch(GAS_URL + "?t=" + new Date().getTime());
            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                updateUI(data, 1000);
            } catch (jsonErr) {
                console.warn("GAS Redirect/CORS Error, menggunakan fallback UI.");
                setFallbackUI();
            }
        } catch (err) {
            console.warn("Koneksi ke GAS lambat/gagal.", err);
        }
    }

    // TAHAP 2: SILENT POST (Merekam IP Pengunjung di Latar Belakang)
    async function recordVisitPost() {
        try {
            const ipResponse = await fetch('https://api.ipify.org?format=json');
            const ipData = await ipResponse.json();
            const clientIP = ipData.ip || 'Unknown';

            const response = await fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({ ip: clientIP })
            });

            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                if(data.status === "success") {
                    updateUI(data, 500); // Update halus jika angka bertambah
                }
            } catch (jsonErr) {
                // Berjalan secara silent
            }
        } catch (error) {
            // Berjalan secara silent
        }
    }

    function setFallbackUI() {
        if(currentStats.today === -1) {
            document.getElementById('val-today').innerHTML = "-";
            document.getElementById('val-week').innerHTML = "-";
            document.getElementById('val-total').innerHTML = "-";
        }
    }

    // EKSEKUSI TAHAP 1: Langsung muat data agar pengunjung instan melihat angka
    fastFetchData();

    // EKSEKUSI TAHAP 2: Rekam IP pengunjung di belakang layar setelah 2 detik
    setTimeout(() => { 
        recordVisitPost(); 
    }, 2000);

    if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>

