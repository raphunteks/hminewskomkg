      "email": "<%= contactEmail %>",
      "telephone": "<%= contactWa.replace(/[^0-9+]/g, '') %>",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "<%= contactAddress %>",
        "addressLocality": "Makassar",
        "addressRegion": "Sulawesi Selatan",
        "postalCode": "90131",
        "addressCountry": "ID"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "<%= seoBaseUrl %>/narahubung/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "<%= seoBaseUrl %>/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Narahubung",
          "item": "<%= seoBaseUrl %>/narahubung"
        }
      ]
