<!-- ==============================================================
     SUPER BIG UPGRADE: ADVANCED SEO & DYNAMIC SCHEMA.ORG INJECTION
     Otomatis mengindeks Berita & Kutipan Kader ke Google Search Console
============================================================== -->
<script type="application/ld+json" id="dynamic-seo-schema">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://hmikomkgumi.xyz/#website",
      "url": "https://hmikomkgumi.xyz/",
      "name": "<%= typeof siteSettings !== 'undefined' ? (siteSettings.heroTitle || siteSettings.webTitle || 'HMI KomKG UMI') : 'HMI KomKG UMI' %>",
      "description": "Website Resmi Himpunan Mahasiswa Islam (HMI) Komisariat Kedokteran Gigi Universitas Muslim Indonesia. Mewujudkan insan akademis, pencipta, pengabdi yang bernafaskan Islam.",
      "inLanguage": "id-ID"
    },
    {
      "@type": "Organization",
      "@id": "https://hmikomkgumi.xyz/#organization",
      "name": "HMI KomKG UMI",
      "url": "https://hmikomkgumi.xyz/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://hmikomkgumi.xyz/img/logo.png"
      }
    }
    <% if(typeof news !== 'undefined' && news.length > 0) { %>,
    {
      "@type": "ItemList",
      "@id": "https://hmikomkgumi.xyz/#news-list",
      "name": "Update Berita dan Kajian Terbaru",
      "itemListElement": [
        <% news.forEach((item, index) => { %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "url": "https://hmikomkgumi.xyz/berita/<%= item.slug %>",
          "item": {
            "@type": "NewsArticle",
            "headline": <%- JSON.stringify(item.title) %>,
            "image": <%- JSON.stringify(item.image) %>,
            "datePublished": <%- JSON.stringify(item.date) %>,
            "url": "https://hmikomkgumi.xyz/berita/<%= item.slug %>",
            "author": {
              "@type": "Organization",
              "name": "Admin HMI KomKG UMI"
            }
          }
        }<%= index < news.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    <% } %>
    <% if(quotesList.length > 0) { %>,
    {
      "@type": "ItemList",
      "@id": "https://hmikomkgumi.xyz/#kader-quotes",
      "name": "Apa Kata Kader - Inspirasi dan Refleksi Kader HMI KomKG UMI",
      "itemListElement": [
        <% quotesList.forEach((q, qIndex) => { %>
        {
          "@type": "ListItem",
          "position": <%= qIndex + 1 %>,
          "item": {
            "@type": "Person",
            "name": <%- JSON.stringify(q.name) %>,
            "jobTitle": <%- JSON.stringify(q.role) %>,
            "image": <%- JSON.stringify(q.image || 'https://hmikomkgumi.xyz/img/logo-hmikomkgumi.png') %>,
            <% if (q.ig && q.ig.trim() !== '') { %>
            "sameAs": [<%- JSON.stringify(q.ig) %>],
            <% } %>
            "description": <%- JSON.stringify(q.quote) %>
          }
        }<%= qIndex < quotesList.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    <% } %>
  ]
}
</script>
