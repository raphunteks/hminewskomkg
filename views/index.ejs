<% 
    // ==============================================================
    // 100% DYNAMIC SSR SEO: Halaman Beranda Resmi
    // ==============================================================
    let page = 'beranda';
    let quotesList = (typeof kaderQuotes !== 'undefined' && Array.isArray(kaderQuotes)) ? kaderQuotes : [];
    let pillarsList = (typeof homePillars !== 'undefined' && Array.isArray(homePillars)) ? homePillars : [];
    let programsList = (typeof homePrograms !== 'undefined' && Array.isArray(homePrograms)) ? homePrograms : [];
    let milestonesList = (typeof homeMilestones !== 'undefined' && Array.isArray(homeMilestones)) ? homeMilestones : [];
    let timelineList = (typeof homeTimeline !== 'undefined' && Array.isArray(homeTimeline)) ? homeTimeline : [];
    let faqList = (typeof homeFaq !== 'undefined' && Array.isArray(homeFaq)) ? homeFaq : [];
    const seoBaseUrl = 'https://www.hmikomkgumi.xyz';
%>
<%- include('partials/header', { page: page }) %>

<!-- ==============================================================
     GOLD STANDARD GSC: DYNAMIC ITEMLIST SCHEMA (NEWS & KADER QUOTES)
============================================================== -->
<% if((typeof news !== 'undefined' && news.length > 0) || (quotesList.length > 0)) { %>
<script type="application/ld+json" id="dynamic-seo-schema-beranda">
{
  "@context": "https://schema.org",
  "@graph": [
    <% if(typeof news !== 'undefined' && news.length > 0) { %>
    {
      "@type": "ItemList",
      "@id": "<%= seoBaseUrl %>/#news-list",
      "name": "Update Berita dan Kajian Terbaru HMI KomKG UMI",
      "description": "Daftar publikasi artikel berita, kajian keislaman, dan warta kegiatan HMI KomKG UMI",
      "itemListElement": [
        <% news.forEach((item, index) => { 
            const itemSlug = item.slug || item.id;
            const itemUrl = `${seoBaseUrl}/berita/${encodeURIComponent(itemSlug)}`;
            let itemImg = item.image || '/img/logo-hmikomkgumi.png';
            if (!itemImg.startsWith('http')) itemImg = seoBaseUrl + (itemImg.startsWith('/') ? '' : '/') + itemImg;
        %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "url": "<%= itemUrl %>",
          "item": {
            "@type": "NewsArticle",
            "headline": <%- JSON.stringify(item.title) %>,
            "image": "<%= itemImg %>",
            "datePublished": <%- JSON.stringify(item.date) %>,
            "url": "<%= itemUrl %>",
            "author": {
              "@type": "Organization",
              "name": "HMI KomKG UMI",
              "url": "<%= seoBaseUrl %>/"
            },
            "publisher": {
              "@id": "<%= seoBaseUrl %>/#organization"
            }
          }
        }<%= index < news.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }<%= quotesList.length > 0 ? ',' : '' %>
    <% } %>
    <% if(quotesList.length > 0) { %>
    {
      "@type": "ItemList",
      "@id": "<%= seoBaseUrl %>/#kader-quotes",
      "name": "Apa Kata Kader - Inspirasi dan Refleksi Kader HMI KomKG UMI",
      "description": "Untaian refleksi, kutipan inspiratif, dan gagasan kader HMI KomKG UMI",
      "itemListElement": [
        <% quotesList.forEach((q, qIndex) => { 
            let qImg = q.image || '/img/logo-hmikomkgumi.png';
            if (!qImg.startsWith('http')) qImg = seoBaseUrl + (qImg.startsWith('/') ? '' : '/') + qImg;
        %>
        {
          "@type": "ListItem",
          "position": <%= qIndex + 1 %>,
          "item": {
            "@type": "Person",
            "name": <%- JSON.stringify(q.name) %>,
            "jobTitle": <%- JSON.stringify(q.role || 'Kader HMI') %>,
            "image": "<%= qImg %>",
            "affiliation": {
              "@id": "<%= seoBaseUrl %>/#organization"
            },
            <% if (q.ig && q.ig.trim() !== '') { %>
            "sameAs": [<%- JSON.stringify(q.ig) %>],
            <% } %>
            "description": <%- JSON.stringify(q.quote) %>
          }
        }<%= qIndex < quotesList.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }<%= (faqList.length > 0) ? ',' : '' %>
    <% } %>
    <% if(faqList.length > 0) { %>
    {
      "@type": "FAQPage",
      "@id": "<%= seoBaseUrl %>/#faq",
      "mainEntity": [
        <% faqList.forEach((faqItem, fIdx) => { %>
        {
          "@type": "Question",
          "name": <%- JSON.stringify(faqItem.question) %>,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": <%- JSON.stringify(faqItem.answer) %>
          }
        }<%= fIdx < faqList.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    <% } %>
  ]
}
</script>
<% } %>
<script src="/js/protect-devtools.js" defer></script>

<!-- POPUP PENGUMUMAN HORIZONTAL -->
<% if (typeof siteSettings !== 'undefined' && (siteSettings.announceActive === 'true' || siteSettings.announceActive === true)) { %>
<%- include('partials/announce') %>
<% } %>

<!-- Semantic WebSite Header -->
<header class="glass hero" itemscope itemtype="https://schema.org/WebSite">
    <link itemprop="url" href="https://hmikomkgumi.xyz"/>
    <span class="badge">Yakusa! Yakin Usaha Sampai</span>
    <h1 itemprop="name">Selamat datang di website resmi <br><span class="text-gradient"><%= siteSettings.heroTitle || siteSettings.webTitle %></span></h1>
    <p itemprop="description">Kami adalah sebuah organisasi mahasiswa yang terdiri dari para mahasiswa kedokteran gigi yang memiliki komitmen untuk meningkatkan kualitas diri dan mengembangkan potensi dalam bidang akademik, keislaman, sosial, dan kemanusiaan.</p>
    <a href="/tentang" class="btn btn-primary" aria-label="Kenali Kami Lebih Dekat">Kenali Kami Lebih Dekat</a>
</header>

<!-- ==============================================================
     SECTION 1: PILAR NILAI INSAN CITA & TRI DHARMA
     (HOLOGRAPHIC GLASS SPOTLIGHT - 100% RESPONSIVE & DYNAMIC SSR)
============================================================== -->
<% if (pillarsList.length > 0) { %>
<section class="home-section-container" aria-label="Pilar Insan Cita dan Nilai Perjuangan">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="compass" style="width:14px; height:14px;"></i> NILAI & IDENTITAS
        </span>
        <h2 class="genz-section-title">Pilar <span class="text-gradient">Insan Cita</span></h2>
        <p class="genz-section-subtitle">Arah langkah dan integritas perjuangan kader kedokteran gigi muslim</p>
    </div>
    <div class="holo-pillar-grid">
        <% pillarsList.forEach(pi => { %>
            <div class="holo-pillar-card">
                <div class="holo-pillar-icon-box">
                    <i data-lucide="<%= pi.icon || 'star' %>" style="width:28px; height:28px;"></i>
                </div>
                <span class="holo-pillar-tag"><%= pi.subtitle %></span>
                <h3 class="holo-pillar-title"><%= pi.title %></h3>
                <p class="holo-pillar-desc"><%= pi.description %></p>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

<!-- ==============================================================
     SUPER BIG UPGRADE: SECTION "APA KATA KADER?" 
     (FIX: QUOTES SCROLLABLE UTUH, INLINE SVG IG, GEN-Z CENTERED)
============================================================== -->
<% if (quotesList.length > 0) { %>
<section class="kader-section-container" aria-label="Apa Kata Kader HMI">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="sparkles" style="width:14px; height:14px;"></i> REFLEKSI & GERAKAN
        </span>
        <h2 class="genz-section-title">Apa Kata <span class="text-gradient">Kader?</span></h2>
        <p class="genz-section-subtitle">Untaian kata inspirasi, idealisme, dan dedikasi kader HMI KomKG UMI</p>
    </div>

    <!-- Container Grid Multi-Kader (Mendukung hingga 5 Orang) -->
    <div class="kader-stream-wrapper">
        <div class="kader-stream-grid">
            <% quotesList.forEach(item => { %>
                <article class="kader-neo-card">
                    <div class="kader-image-frame">
                        <img src="<%= item.image %>" alt="Foto <%= item.name %>" class="kader-portrait" onerror="this.src='/img/logo-hmikomkgumi.png'" loading="lazy" decoding="async">
                        <div class="kader-hologram-overlay"></div>
                        
                        <% if (item.ig && item.ig.trim() !== '') { %>
                            <a href="<%= item.ig %>" target="_blank" rel="noopener noreferrer" class="kader-ig-floating" aria-label="Instagram <%= item.name %>" title="Kunjungi Instagram">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                                </svg>
                            </a>
                        <% } %>
                    </div>
                    
                    <div class="kader-quote-capsule">
                        <div class="kader-quote-symbol">“</div>
                        <!-- Container Scrollable: Teks Utuh Tanpa Terpotong & Grid Tetap Rata -->
                        <div class="kader-quote-scroll-box">
                            <p class="kader-quote-message">“<%= item.quote %>”</p>
                        </div>
                        <div class="kader-profile-info">
                            <h3 class="kader-profile-name"><%= item.name %></h3>
                            <p class="kader-profile-role"><%= item.role %></p>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<!-- ==============================================================
     SECTION 2: PROGRAM KERJA UNGGULAN & AGENDA STRATEGIS
     (INTERACTIVE BENTO GRID - STATUS PILL, DYNAMIC SSR)
============================================================== -->
<% if (programsList.length > 0) { %>
<section class="home-section-container" aria-label="Program Kerja Unggulan">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="layers" style="width:14px; height:14px;"></i> DEDIKASI NYATA
        </span>
        <h2 class="genz-section-title">Program Kerja <span class="text-gradient">Unggulan</span></h2>
        <p class="genz-section-subtitle">Agenda strategis dan kontribusi konkrit bagi mahasiswa & masyarakat</p>
    </div>
    <div class="bento-programs-grid">
        <% programsList.forEach(prog => { 
            let statusClass = 'status-berjalan';
            if (prog.status === 'Terlaksana') statusClass = 'status-terlaksana';
            else if (prog.status === 'Akan Datang') statusClass = 'status-mendatang';
        %>
            <article class="bento-program-card">
                <div class="bento-program-thumb-wrap">
                    <img src="<%= prog.image || '/img/logo-hmikomkgumi.png' %>" alt="<%= prog.title %>" class="bento-program-thumb" onerror="this.src='/img/logo-hmikomkgumi.png'" loading="lazy">
                    <span class="bento-program-status-pill <%= statusClass %>"><%= prog.status %></span>
                </div>
                <div class="bento-program-body">
                    <div class="bento-program-meta">
                        <i data-lucide="calendar" style="width:14px; height:14px;"></i>
                        <span><%= prog.date || 'Agenda Rutin' %></span>
                        <span style="margin-left:auto; opacity:0.85; font-size:0.75rem;"><%= prog.category %></span>
                    </div>
                    <h3 class="bento-program-title"><%= prog.title %></h3>
                    <p class="bento-program-desc"><%= prog.description %></p>
                </div>
            </article>
        <% }) %>
    </div>
</section>
<% } %>

<!-- ==============================================================
     SECTION: BERITA & INFORMASI (GEN-Z CENTERED & 100% SLUG MURNI)
============================================================== -->
<section>
    <div class="genz-header-center" style="margin-top: 70px;">
        <span class="genz-badge-pill">
            <i data-lucide="newspaper" style="width:14px; height:14px;"></i> BERITA & KAJIANN
        </span>
        <h2 class="genz-section-title">Berita & <span class="text-gradient">Informasi</span></h2>
        <p class="genz-section-subtitle">Update kabar terbaru dan dinamika kegiatan komisariat</p>
        
        <!-- Filter Bar Tombol Pill (Interaktif & Modern) -->
        <div class="filter-tags" role="navigation" aria-label="Filter Kategori Berita" style="justify-content: center; margin-top: 20px;">
            <a href="/" class="filter-tag <%= currentFilter === 'Semua' ? 'active' : '' %>" aria-label="Tampilkan Semua Berita">
                <i data-lucide="layout-grid" style="width:14px; height:14px;"></i> Semua
            </a>
            <a href="/?filter=Terbaru" class="filter-tag <%= currentFilter === 'Terbaru' ? 'active' : '' %>" aria-label="Filter Berita Terbaru">
                <i data-lucide="clock" style="width:14px; height:14px;"></i> Terbaru
            </a>
            <a href="/?filter=Pin" class="filter-tag <%= currentFilter === 'Pin' ? 'active' : '' %>" aria-label="Filter Berita Disematkan">
                <i data-lucide="pin" style="width:14px; height:14px;"></i> Pin
            </a>
            <a href="/?filter=Populer" class="filter-tag <%= currentFilter === 'Populer' ? 'active' : '' %>" aria-label="Filter Berita Populer">
                <i data-lucide="trending-up" style="width:14px; height:14px;"></i> Populer
            </a>
        </div>
    </div>

    <div class="grid-3" itemscope itemtype="https://schema.org/ItemList">
        <meta itemprop="itemListOrder" content="https://schema.org/ItemListOrderDescending" />
        
        <% if(news.length > 0) { %>
            <% news.forEach((item, index) => { %>
            
            <article itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style="display:contents;">
                <meta itemprop="position" content="<%= index + 1 %>" />
                
                <a href="/berita/<%= item.slug %>" class="glass news-card" itemprop="item" itemscope itemtype="https://schema.org/NewsArticle">
                    <meta itemprop="url" content="https://hmikomkgumi.xyz/berita/<%= item.slug %>">
                    <meta itemprop="author" content="Admin HMI KomKG UMI">
                    
                    <div class="card-img-wrap">
                        <img itemprop="image" src="<%= item.image %>" alt="Cover Berita: <%= item.title %>" loading="lazy" decoding="async" width="400" height="200">
                        <div class="card-badge" itemprop="articleSection"><%= item.category %></div>
                    </div>
                    <div class="card-body">
                        <div class="card-meta">
                            <i data-lucide="calendar" style="width:14px;"></i> 
                            <time itemprop="datePublished" datetime="<%= item.date %>"><%= item.date %></time>
                            <% if(item.photos && item.photos.length > 0) { %>
                                <span style="margin-left:auto; color:#9ca3af; display:flex; align-items:center; gap:3px;" aria-label="<%= item.photos.length %> Foto Tambahan">
                                    <i data-lucide="image" style="width:12px;"></i> +<%= item.photos.length %>
                                </span>
                            <% } %>
                        </div>
                        <h3 class="card-title" itemprop="headline"><%= item.title %></h3>
                        <p class="card-text" itemprop="description"><%- item.content.replace(/<[^>]+>/g, '').substring(0, 100) %>...</p>
                        <div class="read-more">Baca Selengkapnya <i data-lucide="chevron-right" style="width:16px;"></i></div>
                    </div>
                </a>
            </article>

            <% }) %>
        <% } else { %>
            <p class="text-muted" style="grid-column: 1 / -1; text-align: center; padding: 40px 0;">Belum ada berita dalam kategori ini.</p>
        <% } %>
    </div>
</section>

<!-- ==============================================================
     SECTION 3: STATISTIK PRESTASI & REKAM JEJAK DAMPAK
     (NEUMORPHIC IMPACT COUNTERS - DYNAMIC SSR)
============================================================== -->
<% if (milestonesList.length > 0) { %>
<section class="home-section-container" aria-label="Statistik Prestasi Organisasi">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="award" style="width:14px; height:14px;"></i> REKAM JEJAK
        </span>
        <h2 class="genz-section-title">Jejak & <span class="text-gradient">Prestasi</span></h2>
        <p class="genz-section-subtitle">Dedikasi berkesinambungan mencetak insan akademis, pencipta, dan pengabdi</p>
    </div>
    <div class="milestones-neo-grid">
        <% milestonesList.forEach(m => { %>
            <div class="milestone-neo-card">
                <div class="milestone-icon-circle">
                    <i data-lucide="<%= m.icon || 'award' %>" style="width:24px; height:24px;"></i>
                </div>
                <div class="milestone-number"><%= m.number %></div>
                <h3 class="milestone-label"><%= m.label %></h3>
                <p class="milestone-context"><%= m.context %></p>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

<%- include('partials/instagram-feed') %>

<!-- ==============================================================
     SECTION 4: JEJAK LANGKAH & TIMELINE DINAMIKA KEPENGURUSAN
     (GLOWING GLASS TIMELINE - DYNAMIC SSR)
============================================================== -->
<% if (timelineList.length > 0) { %>
<section class="home-section-container" aria-label="Timeline Dinamika Kepengurusan">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="milestone" style="width:14px; height:14px;"></i> ROADMAP GERAKAN
        </span>
        <h2 class="genz-section-title">Timeline <span class="text-gradient">Perjalanan</span></h2>
        <p class="genz-section-subtitle">Tahapan dinamika kepengurusan dari awal konsolidasi hingga akhir khidmat</p>
    </div>
    <div class="timeline-glass-wrapper">
        <% timelineList.forEach(t => { %>
            <div class="timeline-glass-item">
                <div class="timeline-glass-dot"></div>
                <div class="timeline-glass-card">
                    <div class="timeline-glass-header">
                        <span class="timeline-period-badge">
                            <i data-lucide="clock" style="width:12px; height:12px;"></i> <%= t.period %>
                        </span>
                        <span class="timeline-status-badge status-text-<%= t.status === 'Selesai' ? 'selesai' : (t.status === 'Berjalan' ? 'berjalan' : 'mendatang') %>">
                            <%= t.status %>
                        </span>
                    </div>
                    <h3 class="timeline-card-title"><%= t.title %></h3>
                    <p class="timeline-card-desc"><%= t.description %></p>
                </div>
            </div>
        <% }) %>
    </div>
</section>
<% } %>

<!-- ==============================================================
     SECTION 5: F.A.Q CALON KADER & PUSAT BANTUAN
     (INTERACTIVE GLASS ACCORDION + WHATSAPP CTA - DYNAMIC SSR)
============================================================== -->
<% if (faqList.length > 0) { %>
<section class="home-section-container" aria-label="Pertanyaan Umum Seputar HMI KomKG UMI">
    <div class="genz-header-center">
        <span class="genz-badge-pill">
            <i data-lucide="help-circle" style="width:14px; height:14px;"></i> PUSAT BANTUAN
        </span>
        <h2 class="genz-section-title">Pertanyaan <span class="text-gradient">Umum (FAQ)</span></h2>
        <p class="genz-section-subtitle">Informasi penting yang paling sering ditanyakan oleh calon kader</p>
    </div>
    <div class="faq-neo-wrapper">
        <% faqList.forEach((faq, fIdx) => { %>
            <div class="faq-neo-item <%= fIdx === 0 ? 'active' : '' %>">
                <button type="button" class="faq-neo-question" onclick="toggleFaq(this)" aria-expanded="<%= fIdx === 0 ? 'true' : 'false' %>">
                    <span><%= faq.question %></span>
                    <i data-lucide="chevron-down" class="faq-chevron"></i>
                </button>
                <div class="faq-neo-answer">
                    <%= faq.answer %>
                </div>
            </div>
        <% }) %>
    </div>
    <div class="faq-cta-box">
        <h4 style="color:var(--theme-heading); margin:0; font-size:1.15rem; font-weight:800;">Masih Punya Pertanyaan Lain?</h4>
        <p style="color:var(--theme-text); margin:0; font-size:0.9rem;">Admin dan pengurus kami siap membantu menjawab pertanyaanmu secara langsung.</p>
        <a href="https://api.whatsapp.com/send/?phone=6285338922586&text=Halo%20Admin%20HMI%20KomKG%20UMI,%20saya%20ingin%20bertanya%20seputar%20informasi%20kegiatan%20atau%20pendaftaran%20LK-1.&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer" class="faq-cta-btn">
            <i data-lucide="message-circle" style="width:18px; height:18px;"></i>
            <span>Tanya Langsung ke Admin WhatsApp</span>
        </a>
    </div>
</section>

<script>
function toggleFaq(btn) {
    const item = btn.closest('.faq-neo-item');
    const isActive = item.classList.contains('active');
    document.querySelectorAll('.faq-neo-item').forEach(el => {
        el.classList.remove('active');
        const b = el.querySelector('.faq-neo-question');
        if (b) b.setAttribute('aria-expanded', 'false');
    });
    if (!isActive) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
    }
}
</script>
<% } %>

<!-- UNIFIED REAL-TIME ANALYTICS WIDGET -->
<%- include('partials/analytics') %>

