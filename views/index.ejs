<!-- SCRIPT WIDGET WHATSAPP CHAT -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const waToggleBtn = document.getElementById('waToggleBtn');
    const waChatBox = document.getElementById('waChatBox');
    const waCloseBtn = document.getElementById('waCloseBtn');
    const waSubmitBtn = document.getElementById('waSubmitBtn');
    const waCustomMessage = document.getElementById('waCustomMessage');

    if (waToggleBtn && waChatBox) {
        waToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            waChatBox.classList.toggle('active');
            if (waChatBox.classList.contains('active')) {
                waCustomMessage.focus();
            }
        });
    }

    if (waCloseBtn && waChatBox) {
        waCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            waChatBox.classList.remove('active');
        });
    }

    document.addEventListener('click', (e) => {
        if (waChatBox && waChatBox.classList.contains('active')) {
            if (!waChatBox.contains(e.target) && !waToggleBtn.contains(e.target)) {
                waChatBox.classList.remove('active');
            }
        }
    });

    if (waSubmitBtn) {
        waSubmitBtn.addEventListener('click', () => {
            const rawMsg = (waCustomMessage ? waCustomMessage.value : '').trim();
            const msg = rawMsg || "Halo Admin HMI KomKG UMI, saya ingin bertanya seputar informasi kegiatan komisariat.";
            const waUrl = "https://api.whatsapp.com/send/?phone=6285338922586&text=" + encodeURIComponent(msg) + "&type=phone_number&app_absent=0";
            
            window.open(waUrl, '_blank');
            if (waCustomMessage) waCustomMessage.value = '';
            waChatBox.classList.remove('active');
        });
    }
});
</script>

