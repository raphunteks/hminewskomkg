<script>
// DYNAMIC META TAGS INJECTION (OPEN GRAPH & TWITTER)
document.addEventListener('DOMContentLoaded', () => {
    const metaTags = [
        { name: "description", content: "Website Resmi HMI Komisariat Kedokteran Gigi UMI. Update terbaru seputar kegiatan, proker, dan informasi komisariat." },
        { name: "keywords", content: "HMI KomKG UMI, HMI, Kedokteran Gigi UMI, Organisasi Mahasiswa Makassar, Yakusa, Yakin Usaha Sampai, Proker HMI" },
        { name: "author", content: "Admin HMI KomKG UMI" },
        { property: "og:title", content: "Beranda | HMI KomKG UMI" },
        { property: "og:description", content: "Website Resmi HMI Komisariat Kedokteran Gigi UMI. Wadah pengembangan akademik, keislaman, dan sosial kemasyarakatan." },
        { property: "og:type", content: "website" },
        { property: "og:url", content: "https://hmikomkgumi.xyz/" },
        { property: "twitter:card", content: "summary_large_image" },
        { property: "twitter:title", content: "Beranda | HMI KomKG UMI" }
    ];

    metaTags.forEach(tag => {
        let selector = tag.name ? `meta[name="${tag.name}"]` : `meta[property="${tag.property}"]`;
        if (!document.head.querySelector(selector)) {
            let el = document.createElement('meta');
            if(tag.name) el.name = tag.name;
            if(tag.property) el.setAttribute('property', tag.property);
            el.content = tag.content;
            document.head.appendChild(el);
        }
    });
});
</script>

