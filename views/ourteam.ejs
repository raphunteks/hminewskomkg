<% 
    // ==============================================================
    // ENTERPRISE SEO & BREADCRUMB INJECTION
    // ==============================================================
    let page = 'ourteam';
    let pageTitle = 'Developer Team';
    const defaultAvatar = '/img/logo-hmikomkgumi.png';
    const seoBaseUrl = 'https://hmikomkgumi.xyz';
%>
<%- include('partials/header', { page: page, pageTitle: pageTitle }) %>

<!-- ==============================================================
     DYNAMIC SCHEMA.ORG INJECTION (ABOUT PAGE & PERSON)
     Memaksimalkan Indexing Profil Developer di Google Search
============================================================== -->
<script type="application/ld+json" id="dynamic-seo-schema-team">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "<%= seoBaseUrl %>/ourteam/#webpage",
      "url": "<%= seoBaseUrl %>/ourteam",
      "name": "Developer Team | HMI KomKG UMI",
      "description": "Sosok dibalik layar pengembangan Sistem Informasi BEM KBMFKG UMI & HMI KomKG UMI."
    }
    <% if(typeof devTeam !== 'undefined' && devTeam && devTeam.length > 0) { %>
    , {
      "@type": "ItemList",
      "name": "Daftar Tim Pengembang",
      "itemListElement": [
        <% devTeam.forEach((member, index) => { 
            let memberImg = (member.image && member.image.trim() !== '') ? member.image.trim() : (seoBaseUrl + defaultAvatar);
            if (!memberImg.startsWith('http')) {
                memberImg = seoBaseUrl + (memberImg.startsWith('/') ? '' : '/') + memberImg;
            }
        %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "item": {
            "@type": "Person",
            "name": <%- JSON.stringify(member.name || 'Developer') %>,
            "jobTitle": <%- JSON.stringify(member.role || 'Contributor') %>,
            "image": <%- JSON.stringify(memberImg) %>,
            "affiliation": {
              "@type": "Organization",
              "name": "HMI KomKG UMI"
            },
            "sameAs": [
              <%- member.ig ? JSON.stringify(member.ig) : '""' %>
            ]
          }
        }<%= index < devTeam.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    <% } %>
  ]
}
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const metaTags = [
        { name: "description", content: "Kenali Developer Team hebat dibalik layar pengembangan Sistem Informasi HMI KomKG UMI." },
        { name: "keywords", content: "Developer Team, Programmer HMI, HMI KomKG UMI, Aksa Arsyad, IT HMI" },
        { property: "og:title", content: "Developer Team | HMI KomKG UMI" },
        { property: "og:description", content: "Sosok dibalik layar pengembangan Sistem Informasi web HMI KomKG UMI." },
        { property: "og:type", content: "website" },
        { property: "og:url", content: "<%= seoBaseUrl %>/ourteam" },
        { property: "og:image", content: "<%= seoBaseUrl %><%= defaultAvatar %>" }
    ];

    metaTags.forEach(tag => {
        let selector = tag.name ? `meta[name="${tag.name}"]` : `meta[property="${tag.property}"]`;
        if (!document.head.querySelector(selector)) {
            let el = document.createElement('meta');
            if(tag.name) el.name = tag.name;
            if(tag.property) el.setAttribute('property', tag.property);
            el.content = tag.content;
            document.head.appendChild(el);
        }
    });
});
</script>

<style>
    /* ==============================================================
       STYLING ANALYTICS WIDGET (VIEWS TODAY, THIS WEEK, TOTAL VIEWS)
       PERSIS SEPERTI DI INDEX.EJS
    ============================================================== */
    .analytics-section {
        margin-top: 50px;
        width: 100%;
    }

    .analytics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .analytic-card {
        background: rgba(22, 27, 34, 0.78);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(74, 222, 128, 0.28);
        border-radius: 18px;
        padding: 18px 20px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .analytic-card:hover {
        transform: translateY(-2px);
        border-color: rgba(74, 222, 128, 0.5);
        box-shadow: 0 12px 32px rgba(74, 222, 128, 0.12);
    }

    .analytic-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .analytic-value {
        font-size: 1.65rem;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
    }

    .stat-today { color: #4ade80; }
    .stat-week { color: #38bdf8; }
    .stat-total { color: #fbbf24; }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .spin-icon {
        animation: spin 1s linear infinite;
        width: 22px;
        height: 22px;
        color: #94a3b8;
    }

    @media (max-width: 680px) {
        .analytics-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }
    }
</style>

<section class="container" style="margin-top: 40px; margin-bottom: 80px;">
    <!-- HEADER CREDITS -->
    <div class="dev-page-header">
        <span class="dev-badge">CREDITS</span>
        <h1 class="dev-main-title">Developer <span class="text-blue-gradient">Team</span></h1>
        <p class="dev-subtitle">Sosok dibalik layar pengembangan Sistem Informasi HMI KomKG UMI.</p>
    </div>

    <% 
        // Mengelompokkan tim berdasarkan kategori sesuai urutan desain
        const categories = [
            { name: 'FullStack Development', icon: 'server' },
            { name: 'Backend Development', icon: 'database' },
            { name: 'Frontend Development', icon: 'layout-template' },
            { name: 'UI/UX Design (CSS)', icon: 'pen-tool' }
        ];

        const safeTeam = (typeof devTeam !== 'undefined' && Array.isArray(devTeam)) ? devTeam : [];
    %>

    <% categories.forEach(cat => { %>
        <% const members = safeTeam.filter(m => m.category === cat.name); %>
        <% if(members.length > 0) { %>
            
            <div class="dev-category-wrap">
                <!-- JUDUL KATEGORI -->
                <div class="dev-category-header">
                    <div class="dev-icon-box">
                        <i data-lucide="<%= cat.icon %>"></i>
                    </div>
                    <h2 class="dev-category-title"><%= cat.name %></h2>
                </div>

                <!-- GRID CARDS -->
                <div class="<%= members.length === 1 ? 'grid-dev-1' : 'grid-dev-2' %>">
                    <% members.forEach(member => { 
                        // Sanitasi URL Foto: jika kosong / tidak ada, pakai defaultAvatar
                        let photoSrc = (member.image && member.image.trim() !== '') ? member.image.trim() : defaultAvatar;
                    %>
                        <div class="dev-card">
                            <div class="dev-avatar-wrap">
                                <img src="<%= photoSrc %>" 
                                     alt="<%= member.name %>" 
                                     loading="lazy" 
                                     decoding="async"
                                     onerror="this.onerror=null; this.src='<%= defaultAvatar %>';">
                            </div>
                            <h3 class="dev-name"><%= member.name %></h3>
                            <p class="dev-role"><%= member.role %></p>
                            <p class="dev-dept"><%= member.dept %></p>
                            
                            <div class="dev-divider"></div>
                            
                            <div class="dev-social">
                                <% if(member.ig && member.ig.trim() !== '') { %>
                                    <a href="<%= member.ig %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram <%= member.name %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                                    </a>
                                <% } else { %>
                                    <span style="opacity:0.3;" title="Tidak ada Instagram">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

        <% } %>
    <% }) %>

    <!-- ==============================================================
         SUPER BIG UPGRADE: DASHBOARD ANALYTICS WIDGET
         (PERSIS SEPERTI DI INDEX.EJS)
    ============================================================== -->
    <section class="analytics-section" aria-label="Statistik Kunjungan Website">
        <div class="analytics-grid">
            <div class="analytic-card">
                <h4 class="analytic-title">VIEWS TODAY</h4>
                <div class="analytic-value stat-today" id="val-today">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">THIS WEEK</h4>
                <div class="analytic-value stat-week" id="val-week">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">TOTAL VIEWS</h4>
                <div class="analytic-value stat-total" id="val-total">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
        </div>
    </section>
</section>

<!-- ==============================================================
     SCRIPT PENGGERAK API GOOGLE APPS SCRIPT (PERSIS INDEX.EJS)
============================================================== -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const GAS_URL = "https://script.google.com/macros/s/AKfycbw8MA9YGFK3SIAXhIZAF9m1J4eOGf9LGQD-j4xXjvVSaQ826JrqeEKApPcKJWfJxw/exec";

    let currentStats = { today: -1, week: -1, total: -1 };

    function animateValue(obj, start, end, duration) {
        if (start === end) return; 
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString('id-ID'); 
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }

    function updateUI(data, speed) {
        if(data.today !== undefined && data.today !== currentStats.today) {
            animateValue(document.getElementById('val-today'), Math.max(0, currentStats.today), data.today, speed);
            currentStats.today = data.today;
        }
        if(data.week !== undefined && data.week !== currentStats.week) {
            animateValue(document.getElementById('val-week'), Math.max(0, currentStats.week), data.week, speed);
            currentStats.week = data.week;
        }
        if(data.total !== undefined && data.total !== currentStats.total) {
            animateValue(document.getElementById('val-total'), Math.max(0, currentStats.total), data.total, speed);
            currentStats.total = data.total;
        }
    }

    // TAHAP 1: FAST FETCH (Memuat data dalam milidetik)
    async function fastFetchData() {
        try {
            const response = await fetch(GAS_URL + "?t=" + new Date().getTime());
            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                updateUI(data, 1000);
            } catch (jsonErr) {
                console.warn("GAS Redirect/CORS Error, menggunakan fallback UI.");
                setFallbackUI();
            }
        } catch (err) {
            console.warn("Koneksi ke GAS lambat/gagal.", err);
        }
    }

    // TAHAP 2: SILENT POST (Merekam IP Pengunjung di Latar Belakang)
    async function recordVisitPost() {
        try {
            const ipResponse = await fetch('https://api.ipify.org?format=json');
            const ipData = await ipResponse.json();
            const clientIP = ipData.ip || 'Unknown';

            const response = await fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({ ip: clientIP })
            });

            const textResponse = await response.text(); 
            
            try {
                const data = JSON.parse(textResponse);
                if(data.status === "success") {
                    updateUI(data, 500);
                }
            } catch (jsonErr) {
                // Berjalan secara silent
            }
        } catch (error) {
            // Berjalan secara silent
        }
    }

    function setFallbackUI() {
        if(currentStats.today === -1) {
            document.getElementById('val-today').innerHTML = "-";
            document.getElementById('val-week').innerHTML = "-";
            document.getElementById('val-total').innerHTML = "-";
        }
    }

    fastFetchData();

    setTimeout(() => { 
        recordVisitPost(); 
    }, 2000);

    if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>

<!-- PROTECT INSPECT DEVTOOLS -->
<script src="/js/protect-devtools.js" defer></script>

<%- include('partials/footer') %>
