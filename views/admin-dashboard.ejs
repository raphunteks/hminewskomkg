<% 
    let noIndex = true; 
    let page = 'admin'; 
    let pageTitle = 'Dashboard Administrator'; 
%>
<%- include('partials/header', { page: page, pageTitle: pageTitle, noIndex: noIndex }) %>

<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<% 
    let safeMessages = (typeof contactMessages !== 'undefined' && Array.isArray(contactMessages)) ? contactMessages : [];
    let safeKaderQuotes = (typeof kaderQuotes !== 'undefined' && Array.isArray(kaderQuotes)) ? kaderQuotes : [];
    let safePillars = (typeof homePillars !== 'undefined' && Array.isArray(homePillars)) ? homePillars : [];
    let safePrograms = (typeof homePrograms !== 'undefined' && Array.isArray(homePrograms)) ? homePrograms : [];
    let safeMilestones = (typeof homeMilestones !== 'undefined' && Array.isArray(homeMilestones)) ? homeMilestones : [];
    let safeTimeline = (typeof homeTimeline !== 'undefined' && Array.isArray(homeTimeline)) ? homeTimeline : [];
    let safeFaq = (typeof homeFaq !== 'undefined' && Array.isArray(homeFaq)) ? homeFaq : [];
    let safeNews = (typeof news !== 'undefined' && Array.isArray(news)) ? news : [];
    let safeAlbums = (typeof albums !== 'undefined' && Array.isArray(albums)) ? albums : [];
    let safePengurus = (typeof pengurus !== 'undefined' && Array.isArray(pengurus)) ? pengurus : [];
    let safeBidang = (typeof bidang !== 'undefined' && Array.isArray(bidang)) ? bidang : [];
    let safeKohatiPengurus = (typeof kohatiPengurus !== 'undefined' && Array.isArray(kohatiPengurus)) ? kohatiPengurus : [];
    let safeKohatiBidang = (typeof kohatiBidang !== 'undefined' && Array.isArray(kohatiBidang)) ? kohatiBidang : [];
    let safeDataAnggota = (typeof dataAnggota !== 'undefined' && Array.isArray(dataAnggota)) ? dataAnggota : [];
    let safeShortlinks = (typeof shortlinks !== 'undefined' && Array.isArray(shortlinks)) ? shortlinks : [];
    let safeDevTeam = (typeof devTeam !== 'undefined' && Array.isArray(devTeam)) ? devTeam : [];
%>

<!-- ==============================================================
     LAYOUT DASHBOARD ADMIN DENGAN SIDEBAR COLLAPSIBLE
============================================================== -->
<div class="admin-dashboard-container" id="adminDashboardContainer">
    
    <!-- SIDEBAR KIRI -->
    <aside class="admin-sidebar-nav" id="adminSidebarNav">
        
        <!-- PROFIL DASHBOARD ADMIN -->
        <div class="sidebar-top-header">
            <div class="sidebar-admin-profile">
                <div class="sidebar-admin-avatar">
                    <img src="<%= siteSettings.headerLogo %>" alt="Admin HMI" onerror="this.src='/img/logo-hmikomkgumi.png'">
                </div>
                <div class="sidebar-admin-info">
                    <h2 class="sidebar-admin-title">Dashboard Admin</h2>
                    <p class="sidebar-admin-desc">HMI KomKGUMI</p>
                </div>
            </div>
            <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" onclick="toggleAdminSidebar()" title="Buka/Tutup Sidebar">
                <i data-lucide="panel-left-close" id="sidebarCollapseIcon"></i>
            </button>
        </div>

        <!-- Tombol Tambah Berita Baru -->
        <div class="sidebar-action-wrap">
            <button type="button" class="btn-sidebar-create" onclick="openModal('modalBerita')" title="Tambah Berita Baru">
                <i data-lucide="plus" style="width:20px; height:20px;"></i>
                <span class="sidebar-text">Tambah Berita</span>
            </button>
        </div>

        <!-- DAFTAR MENU SIDEBAR -->
        <div class="sidebar-menu-list">
            <button type="button" class="sidebar-nav-item active" data-tab-target="adm-overview" onclick="openAdmTab('adm-overview', this)" title="Overview Analytics">
                <div class="sidebar-nav-icon-wrap">
                    <i data-lucide="layout-dashboard"></i>
                </div>
                <span class="sidebar-text">Overview</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-pesan" onclick="openAdmTab('adm-pesan', this)" title="Pesan Narahubung">
                <div class="sidebar-nav-icon-wrap">
                    <i data-lucide="inbox"></i>
                    <% if (safeMessages.length > 0) { %>
                        <span class="sidebar-badge-dot"><%= safeMessages.length %></span>
                    <% } %>
                </div>
                <span class="sidebar-text">Pesan Narahubung</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-kelola" onclick="openAdmTab('adm-kelola', this)" title="Kelola Data">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="database"></i></div>
                <span class="sidebar-text">Kelola Data</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-kaderquote" onclick="openAdmTab('adm-kaderquote', this)" title="Apa Kata Kader?">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="quote"></i></div>
                <span class="sidebar-text">Apa Kata Kader?</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-beranda-sections" onclick="openAdmTab('adm-beranda-sections', this)" title="Section Beranda (Pilar, Proker, Milestones, Timeline, FAQ)">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="layout-template"></i></div>
                <span class="sidebar-text">Section Beranda</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-setelan" onclick="openAdmTab('adm-setelan', this)" title="Header, Footer, Tentang & Narahubung">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="settings"></i></div>
                <span class="sidebar-text">Setelan Web & Kontak</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-sosmed" onclick="openAdmTab('adm-sosmed', this)" title="Sosial Media">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="share-2"></i></div>
                <span class="sidebar-text">Sosial Media</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-bio" onclick="openAdmTab('adm-bio', this)" title="Link in Bio">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="smartphone"></i></div>
                <span class="sidebar-text">Link in Bio</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-shortlink" onclick="openAdmTab('adm-shortlink', this)" title="Shortlink Custom">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="link"></i></div>
                <span class="sidebar-text">Shortlink Custom</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-devteam" onclick="openAdmTab('adm-devteam', this)" title="Developer Team">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="code"></i></div>
                <span class="sidebar-text">Developer Team</span>
            </button>

            <button type="button" class="sidebar-nav-item" data-tab-target="adm-announce" onclick="openAdmTab('adm-announce', this)" title="Announcement Pop-up">
                <div class="sidebar-nav-icon-wrap"><i data-lucide="bell"></i></div>
                <span class="sidebar-text">Announcement</span>
            </button>
        </div>

        <!-- TOMBOL LOGOUT -->
        <div class="sidebar-footer-wrap">
            <a href="/admin/logout" class="sidebar-logout-btn" title="Logout dari Sistem">
                <div class="sidebar-nav-icon-wrap">
                    <i data-lucide="log-out"></i>
                </div>
                <span class="sidebar-text">Logout</span>
            </a>
        </div>
    </aside>

    <!-- ==============================================================
         NAVIGASI KHUSUS MOBILE & TABLET (RINGKAS & ANTI-KEPANJANGAN)
    ============================================================== -->
    <div class="admin-mobile-nav-container">
        <!-- 1. MOBILE ADMIN CONTROL BAR -->
        <div class="admin-mobile-control-bar glass">
            <div class="mobile-admin-info">
                <div class="mobile-admin-avatar">
                    <img src="<%= siteSettings.headerLogo %>" alt="Admin" onerror="this.src='/img/logo-hmikomkgumi.png'">
                </div>
                <div>
                    <strong class="mobile-admin-title">Dashboard Admin</strong>
                    <span class="mobile-tab-indicator" id="mobileActiveTabLabel">Overview</span>
                </div>
            </div>
            <div class="mobile-admin-actions">
                <button type="button" class="mobile-btn-action" onclick="openModal('modalBerita')" title="Tambah Berita">
                    <i data-lucide="plus"></i> <span>Berita</span>
                </button>
                <a href="/admin/logout" class="mobile-btn-logout" title="Logout">
                    <i data-lucide="log-out"></i>
                </a>
            </div>
        </div>

        <!-- 2. STICKY HORIZONTAL SWIPEABLE PILLS TAB BAR -->
        <div class="admin-mobile-pills-bar">
            <div class="admin-mobile-pills-scroll" id="adminMobilePillsScroll">
                <button type="button" class="mobile-tab-pill active" data-tab-target="adm-overview" onclick="openAdmTab('adm-overview', this)">
                    <i data-lucide="layout-dashboard"></i> Overview
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-pesan" onclick="openAdmTab('adm-pesan', this)">
                    <i data-lucide="inbox"></i> Pesan
                    <% if (safeMessages.length > 0) { %><span class="pill-badge"><%= safeMessages.length %></span><% } %>
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-kelola" onclick="openAdmTab('adm-kelola', this)">
                    <i data-lucide="database"></i> Kelola Data
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-kaderquote" onclick="openAdmTab('adm-kaderquote', this)">
                    <i data-lucide="quote"></i> Apa Kata Kader?
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-beranda-sections" onclick="openAdmTab('adm-beranda-sections', this)">
                    <i data-lucide="layout-template"></i> Section Beranda
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-setelan" onclick="openAdmTab('adm-setelan', this)">
                    <i data-lucide="settings"></i> Setelan Web
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-sosmed" onclick="openAdmTab('adm-sosmed', this)">
                    <i data-lucide="share-2"></i> Sosmed
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-bio" onclick="openAdmTab('adm-bio', this)">
                    <i data-lucide="smartphone"></i> Link Bio
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-shortlink" onclick="openAdmTab('adm-shortlink', this)">
                    <i data-lucide="link"></i> Shortlink
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-devteam" onclick="openAdmTab('adm-devteam', this)">
                    <i data-lucide="code"></i> Dev Team
                </button>
                <button type="button" class="mobile-tab-pill" data-tab-target="adm-announce" onclick="openAdmTab('adm-announce', this)">
                    <i data-lucide="bell"></i> Pengumuman
                </button>
            </div>
        </div>
    </div>

    <!-- KONTEN UTAMA DASHBOARD -->
    <main class="admin-main-wrap">

        <!-- ==============================================================
             TAB: OVERVIEW ANALYTICS (GLASSMORPHISM + NEUMORPHISM + HOLOGRAPHIC)
        ============================================================== -->
        <div id="adm-overview" class="admin-tab-pane active" style="display: block;">
            <div class="ovw-container">

                <!-- 1. TOP CONTROL BAR -->
                <div class="ovw-top-bar">
                    <div class="ovw-header-left">
                        <div class="ovw-title-wrap">
                            <h1 class="ovw-main-title">Dashboard</h1>
                        </div>
                        <p class="ovw-subtitle">Pantauan performa web, aktivitas pengunjung, dan modul organisasi HMI KomKG UMI.</p>
                    </div>

                    <div class="ovw-controls-right">
                        <div class="ovw-search-box" title="Cari modul atau berita">
                            <i data-lucide="search"></i>
                            <input type="text" id="ovwSearchInput" placeholder="Cari konten, modul..." oninput="filterOverviewActivity(this.value)">
                        </div>
                        <div class="ovw-live-status" title="Sistem terhubung ke Upstash Redis KV">
                            <span class="ovw-pulse-dot"></span>
                            <span class="ovw-live-text">Live Sync</span>
                        </div>
                        <button type="button" class="ovw-refresh-btn" id="ovwRefreshBtn" onclick="fetchAnalyticsData(true)" title="Sinkronkan Analitik Sekarang">
                            <i data-lucide="rotate-cw" id="ovwRefreshIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- 2. FOUR KPI STAT CARDS WITH SVG SPARKLINES -->
                <div class="ovw-kpi-grid">
                    
                    <!-- KPI 1: TOTAL KUNJUNGAN -->
                    <div class="ovw-kpi-card ovw-card-blue">
                        <div class="ovw-card-head">
                            <span class="ovw-card-label">Total Kunjungan</span>
                            <span class="ovw-card-badge up"><i data-lucide="trending-up" style="width:12px; height:12px;"></i> +48%</span>
                        </div>
                        <div class="ovw-card-body">
                            <h2 class="ovw-card-value" id="ovw-stat-total">173</h2>
                            <p class="ovw-card-desc">Akumulasi pembaca web resmi</p>
                        </div>
                        <div class="ovw-sparkline-wrap">
                            <svg class="ovw-sparkline-svg" viewBox="0 0 100 35" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="sparkGradBlue" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#38bdf8"/>
                                        <stop offset="100%" stop-color="#60a5fa"/>
                                    </linearGradient>
                                    <linearGradient id="sparkAreaBlue" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
                                        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path class="ovw-sparkline-area" d="M0,25 Q18,5 35,18 T70,12 T100,6 L100,35 L0,35 Z" fill="url(#sparkAreaBlue)"/>
                                <path class="ovw-sparkline-path" d="M0,25 Q18,5 35,18 T70,12 T100,6" stroke="url(#sparkGradBlue)"/>
                            </svg>
                        </div>
                    </div>

                    <!-- KPI 2: PENGUNJUNG HARI INI -->
                    <div class="ovw-kpi-card ovw-card-green">
                        <div class="ovw-card-head">
                            <span class="ovw-card-label">Pengunjung Hari Ini</span>
                            <span class="ovw-card-badge up"><i data-lucide="zap" style="width:12px; height:12px;"></i> Live</span>
                        </div>
                        <div class="ovw-card-body">
                            <h2 class="ovw-card-value" id="ovw-stat-today">3</h2>
                            <p class="ovw-card-desc">Minggu ini: <strong id="ovw-stat-week" style="color:var(--theme-heading);">7</strong> kunjungan</p>
                        </div>
                        <div class="ovw-sparkline-wrap">
                            <svg class="ovw-sparkline-svg" viewBox="0 0 100 35" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="sparkGradGreen" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#34d399"/>
                                        <stop offset="100%" stop-color="#10b981"/>
                                    </linearGradient>
                                    <linearGradient id="sparkAreaGreen" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#34d399" stop-opacity="0.35"/>
                                        <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path class="ovw-sparkline-area" d="M0,28 Q22,12 40,24 T75,10 T100,4 L100,35 L0,35 Z" fill="url(#sparkAreaGreen)"/>
                                <path class="ovw-sparkline-path" d="M0,28 Q22,12 40,24 T75,10 T100,4" stroke="url(#sparkGradGreen)"/>
                            </svg>
                        </div>
                    </div>

                    <!-- KPI 3: KONTEN & PUBLIKASI -->
                    <div class="ovw-kpi-card ovw-card-purple">
                        <div class="ovw-card-head">
                            <span class="ovw-card-label">Konten & Galeri</span>
                            <span class="ovw-card-badge purple"><i data-lucide="layers" style="width:12px; height:12px;"></i> <%= safeNews.length %> Berita</span>
                        </div>
                        <div class="ovw-card-body">
                            <h2 class="ovw-card-value"><%= safeNews.length + safeAlbums.length + safeKaderQuotes.length %></h2>
                            <p class="ovw-card-desc"><%= safeAlbums.length %> Galeri · <%= safeKaderQuotes.length %> Quote Kader</p>
                        </div>
                        <div class="ovw-sparkline-wrap">
                            <svg class="ovw-sparkline-svg" viewBox="0 0 100 35" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="sparkGradPurple" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#c084fc"/>
                                        <stop offset="100%" stop-color="#a855f7"/>
                                    </linearGradient>
                                    <linearGradient id="sparkAreaPurple" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#c084fc" stop-opacity="0.35"/>
                                        <stop offset="100%" stop-color="#c084fc" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path class="ovw-sparkline-area" d="M0,30 Q25,18 45,20 T78,8 T100,10 L100,35 L0,35 Z" fill="url(#sparkAreaPurple)"/>
                                <path class="ovw-sparkline-path" d="M0,30 Q25,18 45,20 T78,8 T100,10" stroke="url(#sparkGradPurple)"/>
                            </svg>
                        </div>
                    </div>

                    <!-- KPI 4: KADER & PENGURUS -->
                    <div class="ovw-kpi-card ovw-card-amber">
                        <div class="ovw-card-head">
                            <span class="ovw-card-label">Kader & Tim</span>
                            <span class="ovw-card-badge info"><i data-lucide="users" style="width:12px; height:12px;"></i> Terdata</span>
                        </div>
                        <div class="ovw-card-body">
                            <h2 class="ovw-card-value"><%= safeDataAnggota.length + safePengurus.length + safeKohatiPengurus.length %></h2>
                            <p class="ovw-card-desc"><%= safeDataAnggota.length %> Anggota PDF · <%= safePengurus.length + safeKohatiPengurus.length %> BPH/KOHATI</p>
                        </div>
                        <div class="ovw-sparkline-wrap">
                            <svg class="ovw-sparkline-svg" viewBox="0 0 100 35" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="sparkGradAmber" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#fbbf24"/>
                                        <stop offset="100%" stop-color="#f59e0b"/>
                                    </linearGradient>
                                    <linearGradient id="sparkAreaAmber" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.35"/>
                                        <stop offset="100%" stop-color="#fbbf24" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path class="ovw-sparkline-area" d="M0,22 Q20,28 42,15 T80,18 T100,5 L100,35 L0,35 Z" fill="url(#sparkAreaAmber)"/>
                                <path class="ovw-sparkline-path" d="M0,22 Q20,28 42,15 T80,18 T100,5" stroke="url(#sparkGradAmber)"/>
                            </svg>
                        </div>
                    </div>

                </div>

                <!-- 3. CENTRAL LARGE GROWTH CHART -->
                <div class="ovw-chart-panel">
                    <div class="ovw-chart-head">
                        <h3 class="ovw-panel-title">
                            <i data-lucide="trending-up"></i>
                            Tren Kunjungan & Pertumbuhan Interaksi
                        </h3>
                        <div class="ovw-chart-actions">
                            <div class="ovw-peak-callout" id="ovwPeakCallout">
                                <span class="ovw-peak-dot"></span>
                                Puncak: <strong id="ovwPeakVal" style="color:inherit; margin-left:2px;">1,280 Kunjungan</strong>
                            </div>
                            <div class="ovw-filter-group">
                                <button type="button" class="ovw-filter-pill active" onclick="switchOverviewTrafficRange('7d', this)">7 Hari</button>
                                <button type="button" class="ovw-filter-pill" onclick="switchOverviewTrafficRange('30d', this)">30 Hari</button>
                                <button type="button" class="ovw-filter-pill" onclick="switchOverviewTrafficRange('month', this)">Bulan Ini</button>
                                <button type="button" class="ovw-filter-pill" onclick="switchOverviewTrafficRange('year', this)">Tahun Ini</button>
                            </div>
                        </div>
                    </div>
                    <div class="ovw-canvas-wrap">
                        <canvas id="overviewTrafficChart"></canvas>
                    </div>
                </div>

                <!-- 4. TWO-COLUMN SPLIT: RECENT ACTIVITY & TASK DISTRIBUTION -->
                <div class="ovw-split-grid">
                    
                    <!-- LEFT COLUMN: RECENT CONTENT & ACTIVITIES -->
                    <div class="ovw-table-panel">
                        <div>
                            <div class="ovw-chart-head" style="margin-bottom:12px;">
                                <h3 class="ovw-panel-title">
                                    <i data-lucide="clock"></i>
                                    Aktivitas Konten & Organisasi Terbaru
                                </h3>
                                <span class="badge" style="background:rgba(56,189,248,0.12); color:#0284c7; border:1px solid rgba(56,189,248,0.25); font-size:0.75rem;">
                                    Total Konten: <%= safeNews.length %>
                                </span>
                            </div>
                            <div class="ovw-table-wrapper">
                                <table class="ovw-table" id="ovwActivityTable">
                                    <thead>
                                        <tr>
                                            <th>Nama Konten / Berita</th>
                                            <th>Tim / PIC</th>
                                            <th>Status</th>
                                            <th>Interaksi & Pembaca</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ovwActivityTableBody">
                                        <% if (safeNews.length > 0) { %>
                                            <% safeNews.slice(0, 5).forEach((item, idx) => { 
                                                let estViews = Math.floor(100 + (idx * 37) + (item.title ? item.title.length * 2 : 15));
                                                let progPercent = Math.min(100, Math.max(25, 100 - (idx * 16)));
                                            %>
                                            <tr class="ovw-activity-row" data-search="<%= (item.title || '') + ' ' + (item.category || '') %>">
                                                <td>
                                                    <div class="ovw-item-info">
                                                        <a href="/berita/<%= item.slug || item.id %>" target="_blank" class="ovw-item-title" title="<%= item.title %>">
                                                            <%= item.title %>
                                                        </a>
                                                        <span class="ovw-item-meta">
                                                            <i data-lucide="calendar" style="width:11px; height:11px; display:inline; vertical-align:middle;"></i>
                                                            <%= item.date || 'Terbaru' %> · <%= item.category || 'Berita' %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="ovw-avatar-stack" title="Tim Redaksi HMI KomKG">
                                                        <div class="ovw-avatar-mini" style="background:#38bdf8; color:#fff;">HM</div>
                                                        <div class="ovw-avatar-mini" style="background:#10b981; color:#fff;">KG</div>
                                                        <div class="ovw-avatar-mini" style="background:#a855f7; color:#fff;">UM</div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (idx === 0) { %>
                                                        <span class="ovw-status-pill pinned"><i data-lucide="pin" style="width:11px; height:11px;"></i> Terbit Utama</span>
                                                    <% } else { %>
                                                        <span class="ovw-status-pill published"><i data-lucide="check-circle" style="width:11px; height:11px;"></i> Published</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="ovw-prog-cell">
                                                        <div class="ovw-prog-track">
                                                            <div class="ovw-prog-bar" data-progress="<%= progPercent %>"></div>
                                                        </div>
                                                        <span class="ovw-prog-text"><%= estViews %></span>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        <% } else { %>
