                                        <td style="color:#16a34a; font-size:0.85rem;"><%= person.role %></td>
                                        <td class="td-actions">
                                            <button type="button" class="action-btn edit" onclick="openEditDynamic('<%= person.id %>', '', '', '/admin/edit-pengurus/')"><i data-lucide="edit"></i></button>
                                            <form action="/admin/hapus-pengurus/<%= person.id %>" method="POST" class="form-inline"><button type="submit" class="action-btn delete" onclick="return confirm('Yakin?')"><i data-lucide="trash-2"></i></button></form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <div class="bidang-container">
