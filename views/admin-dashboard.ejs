    function openAdmTab(tabId, btn) {
        document.querySelectorAll('.admin-tab-pane').forEach(tab => {
            tab.classList.remove('active');
            tab.style.display = 'none';
        });

        // Hapus status active dari tombol desktop dan pills mobile
        document.querySelectorAll('.sidebar-nav-item, .mobile-tab-pill').forEach(b => b.classList.remove('active'));

        const target = document.getElementById(tabId);
        if (target) {
            target.classList.add('active');
            target.style.display = 'block';
        }

        // Sinkronisasi status active ke seluruh tombol yang menarget tab ini (desktop & mobile)
        document.querySelectorAll(`[data-tab-target="${tabId}"]`).forEach(b => b.classList.add('active'));

        // Update indikator teks aktif di Mobile Control Bar
        const labelEl = document.getElementById('mobileActiveTabLabel');
        if (labelEl && tabLabels[tabId]) {
            labelEl.innerText = tabLabels[tabId];
        }

        // Simpan ke URL query param agar state tab tetap terjaga saat reload
        try {
            const currentUrl = new URL(window.location);
            currentUrl.searchParams.set('tab', tabId);
            window.history.replaceState({}, '', currentUrl);
        } catch (e) {}

        // Geser pill aktif ke tengah pandangan di bar horizontal mobile
        const activePill = document.querySelector(`.mobile-tab-pill[data-tab-target="${tabId}"]`);
        if (activePill) {
            activePill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        if (typeof lucide !== 'undefined') lucide.createIcons();
        if (tabId === 'adm-overview') {
            triggerOverviewChartsRedraw();
        }
        window.dispatchEvent(new Event('resize'));
    }

