                                <canvas id="overviewDistributionChart"></canvas>
                            </div>

                            <div class="ovw-legend-list">
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#38bdf8;"></span>
                                        Berita & Opini
                                    </span>
                                    <span class="ovw-legend-count"><%= safeNews.length %></span>
                                </div>
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#10b981;"></span>
                                        Galeri Kegiatan
                                    </span>
                                    <span class="ovw-legend-count"><%= safeAlbums.length %></span>
                                </div>
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#a855f7;"></span>
                                        Pengurus & KOHATI
                                    </span>
                                    <span class="ovw-legend-count"><%= safePengurus.length + safeKohatiPengurus.length %></span>
                                </div>
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#f59e0b;"></span>
                                        Data Anggota PDF
                                    </span>
                                    <span class="ovw-legend-count"><%= safeDataAnggota.length %></span>
                                </div>
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#ef4444;"></span>
                                        Pesan Narahubung
                                    </span>
                                    <span class="ovw-legend-count"><%= safeMessages.length %></span>
                                </div>
                                <div class="ovw-legend-item">
                                    <span class="ovw-legend-left">
                                        <span class="ovw-legend-dot" style="background:#64748b;"></span>
                                        Shortlink & Bio
                                    </span>
                                    <span class="ovw-legend-count"><%= safeShortlinks.length %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- TAB: PESAN MASUK DARI NARAHUBUNG -->
        <div id="adm-pesan" class="admin-tab-pane" style="display: none;">
            <div class="glass admin-panel" style="margin-bottom:0; border-top: 4px solid #0284c7;">
                <div class="panel-header">
                    <h3 class="panel-title" style="color:#38bdf8;"><i data-lucide="inbox" style="color:#38bdf8;"></i> Kotak Masuk Pesan Narahubung</h3>
                    <div class="panel-actions">
                        <span class="badge" style="background:rgba(2,132,199,0.15); color:#38bdf8; border-color:rgba(2,132,199,0.3);">
                            Total Pesan: <%= safeMessages.length %>
                        </span>
                    </div>
                </div>

                <p class="text-muted" style="font-size:0.85rem; margin-bottom: 20px;">
                    Daftar formulir pesan masuk yang dikirimkan langsung oleh pengunjung melalui halaman <strong>/narahubung</strong>. Anda dapat melihat dokumen pendukung, membaca pesan lengkap, membalas ke WhatsApp/Email pengirim, atau menghapus arsip.
                </p>

                <div class="table-scroll-hint"><i data-lucide="chevrons-left-right"></i> Geser tabel ke samping untuk melihat seluruh kolom & aksi</div>
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Nama / Instansi</th>
                                <th>Metode & Kontak</th>
                                <th>Tujuan Pesan</th>
                                <th>Dokumen</th>
                                <th style="text-align:right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% safeMessages.forEach((msg, mIdx) => { %>
                            <tr>
                                <td style="font-size:0.8rem; color:#9ca3af; white-space:nowrap;">
                                    <%= msg.date || new Date().toLocaleDateString('id-ID') %>
                                </td>
                                <td class="fw-600">
                                    <span style="color:var(--theme-heading);"><%= msg.name %></span>
                                </td>
                                <td>
                                    <% if (msg.method === 'wa') { %>
                                        <a href="https://api.whatsapp.com/send/?phone=<%= msg.contact.replace(/[^0-9]/g, '') %>&text=Halo%20<%= encodeURIComponent(msg.name) %>,%20kami%20dari%20Admin%20HMI%20KomKG%20UMI" target="_blank" class="cat-badge" style="background:rgba(34,197,94,0.15); color:#16a34a; border:1px solid rgba(34,197,94,0.3); text-decoration:none; display:inline-flex; align-items:center; gap:5px;">
                                            <i data-lucide="message-circle" style="width:13px;"></i> <%= msg.contact %>
                                        </a>
                                    <% } else { %>
                                        <a href="mailto:<%= msg.contact %>?subject=Balasan%20Pesan%20HMI%20KomKG%20UMI" class="cat-badge" style="background:rgba(2,132,199,0.15); color:#0284c7; border:1px solid rgba(2,132,199,0.3); text-decoration:none; display:inline-flex; align-items:center; gap:5px;">
                                            <i data-lucide="mail" style="width:13px;"></i> <%= msg.contact %>
                                        </a>
                                    <% } %>
                                </td>
                                <td>
                                    <span style="font-size:0.85rem; color:var(--theme-text);"><%= msg.subject %></span>
                                </td>
                                <td>
                                    <% if (msg.docUrl && msg.docUrl.length > 5) { %>
                                        <a href="<%= msg.docUrl %>" target="_blank" class="action-btn" style="color:#16a34a; text-decoration:none; padding:4px 8px; font-size:0.75rem; display:inline-flex; align-items:center; gap:4px;" title="Unduh / Lihat Dokumen">
                                            <i data-lucide="file-text" style="width:14px;"></i> Lihat File
                                        </a>
                                    <% } else { %>
                                        <span style="color:#9ca3af; font-size:0.8rem;">-</span>
                                    <% } %>
                                </td>
                                <td class="td-actions">
                                    <div id="raw-message-body-<%= msg.id %>" style="display:none;"><%- msg.message %></div>
                                    <button type="button" class="action-btn" style="color:#0284c7;" onclick="openDetailPesanModal('<%= msg.id %>')" title="Baca Isi Pesan">
                                        <i data-lucide="eye"></i>
                                    </button>
                                    <form action="/admin/hapus-pesan/<%= msg.id %>" method="POST" class="form-inline">
                                        <button type="submit" class="action-btn delete" onclick="return confirm('Hapus pesan masuk ini secara permanen?')" title="Hapus Pesan">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>

                            <% if (safeMessages.length === 0) { %>
                                <tr>
                                    <td colspan="6" style="text-align:center; padding:35px; color:#9ca3af; font-size:0.9rem;">
                                        <i data-lucide="inbox" style="width:36px; height:36px; margin: 0 auto 10px; opacity:0.4; display:block;"></i>
                                        Belum ada pesan masuk dari formulir narahubung.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 1: KELOLA DATA UTAMA (BERITA DENGAN SLUG MURNI) -->
        <div id="adm-kelola" class="admin-tab-pane" style="display: none;">
            <div class="admin-layout">
                <div class="admin-main-content">
                    <!-- PANEL KELOLA BERITA -->
                    <div class="glass admin-panel" style="margin-bottom:0;">
                        <div class="panel-header">
                            <h3 class="panel-title"><i data-lucide="file-text"></i> Kelola Berita</h3>
                            <button class="btn btn-primary" onclick="openModal('modalBerita')" style="padding:8px 15px; font-size:0.85rem;">+ Tambah Berita</button>
                        </div>
                        <div class="table-wrapper">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Judul & URL Slug (SEO)</th>
                                        <th>Kategori</th>
                                        <th style="text-align:right;">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% news.forEach(item => { %>
                                    <tr>
                                        <td class="fw-600">
                                            <span style="color:var(--theme-heading);"><%= item.title %></span>
                                            <div style="font-size:0.75rem; color:#16a34a; margin-top:3px; display:flex; align-items:center; gap:8px;">
                                                <span><i data-lucide="calendar" style="width:12px; display:inline;"></i> <%= item.date %></span>
                                                <span>•</span>
                                                <a href="/berita/<%= item.slug %>" target="_blank" style="color:#38bdf8; text-decoration:none; display:inline-flex; align-items:center; gap:3px;">
                                                    <i data-lucide="link" style="width:12px;"></i> /berita/<%= item.slug %>
                                                </a>
                                            </div>
                                        </td>
                                        <td><span class="cat-badge"><%= item.category %></span></td>
                                        <td class="td-actions">
                                            <div id="raw-content-<%= item.id %>" style="display: none;"><%- item.content %></div>
                                            <a href="/berita/<%= item.slug %>" target="_blank" class="action-btn" style="color:#38bdf8;" title="Lihat Berita Live"><i data-lucide="external-link"></i></a>
                                            <button type="button" class="action-btn" style="color:var(--theme-text);" onclick="openKelolaFotoBerita('<%= item.id %>')" title="Kelola Foto"><i data-lucide="image-plus"></i></button>
                                            <button type="button" class="action-btn edit" onclick="openEditBeritaModal('<%= item.id %>')" title="Edit Berita"><i data-lucide="edit"></i></button>
                                            <form action="/admin/hapus-berita/<%= item.id %>" method="POST" class="form-inline"><button type="submit" class="action-btn delete" onclick="return confirm('Hapus berita?')"><i data-lucide="trash-2"></i></button></form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% if (news.length === 0) { %>
                                        <tr><td colspan="3" style="text-align:center; padding:20px; opacity:0.6;">Belum ada berita.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- PANEL PENGURUS HARIAN UMUM -->
                    <div class="glass admin-panel" style="margin-bottom:0;">
                        <div class="panel-header">
                            <h3 class="panel-title"><i data-lucide="users"></i> Pengurus Harian (Umum)</h3>
