<script id="contactMessagesJson" type="application/json"><%- JSON.stringify(safeMessages).replace(/</g, '\\u003c') %></script>
<script id="kaderQuotesJson" type="application/json"><%- JSON.stringify(safeKaderQuotes).replace(/</g, '\\u003c') %></script>
<script id="pengurusDataJson" type="application/json"><%- typeof pengurus !== 'undefined' ? JSON.stringify(pengurus).replace(/</g, '\\u003c') : '[]' %></script>
<script id="bidangDataJson" type="application/json"><%- typeof bidang !== 'undefined' ? JSON.stringify(bidang).replace(/</g, '\\u003c') : '[]' %></script>
<script id="kohatiPengurusDataJson" type="application/json"><%- typeof kohatiPengurus !== 'undefined' ? JSON.stringify(kohatiPengurus).replace(/</g, '\\u003c') : '[]' %></script>
<script id="kohatiBidangDataJson" type="application/json"><%- typeof kohatiBidang !== 'undefined' ? JSON.stringify(kohatiBidang).replace(/</g, '\\u003c') : '[]' %></script>
<script id="dataAnggotaDataJson" type="application/json"><%- typeof safeDataAnggota !== 'undefined' ? JSON.stringify(safeDataAnggota).replace(/</g, '\\u003c') : (typeof dataAnggota !== 'undefined' ? JSON.stringify(dataAnggota).replace(/</g, '\\u003c') : '[]') %></script>
<script id="socialMediaListDataJson" type="application/json"><%- typeof socialMediaList !== 'undefined' ? JSON.stringify(socialMediaList).replace(/</g, '\\u003c') : '[]' %></script>
<script id="shortlinksDataJson" type="application/json"><%- typeof shortlinks !== 'undefined' ? JSON.stringify(shortlinks).replace(/</g, '\\u003c') : '[]' %></script>
<script id="devTeamDataJson" type="application/json"><%- typeof devTeam !== 'undefined' ? JSON.stringify(devTeam).replace(/</g, '\\u003c') : '[]' %></script>
<script id="homePillarsJson" type="application/json"><%- JSON.stringify(safePillars).replace(/</g, '\\u003c') %></script>
<script id="homeProgramsJson" type="application/json"><%- JSON.stringify(safePrograms).replace(/</g, '\\u003c') %></script>
<script id="homeMilestonesJson" type="application/json"><%- JSON.stringify(safeMilestones).replace(/</g, '\\u003c') %></script>
<script id="homeTimelineJson" type="application/json"><%- JSON.stringify(safeTimeline).replace(/</g, '\\u003c') %></script>
<script id="homeFaqJson" type="application/json"><%- JSON.stringify(safeFaq).replace(/</g, '\\u003c') %></script>

<script>
    let albumsData = []; 
    let newsData = [];
    let bioPagesData = [];
    let bioLinksData = [];
    let contactMessagesData = [];
    let kaderQuotesData = [];
    let pengurusData = [];
    let bidangData = [];
    let kohatiPengurusData = [];
    let kohatiBidangData = [];
    let dataAnggotaData = [];
    let socialMediaListData = [];
    let shortlinksData = [];
    let devTeamData = [];
    let homePillarsData = [];
    let homeProgramsData = [];
    let homeMilestonesData = [];
    let homeTimelineData = [];
    let homeFaqData = [];

    function parseJsonScript(scriptId) {
        try {
            const el = document.getElementById(scriptId);
            if (!el) return [];
            const raw = el.textContent;
            if (raw && raw.trim() !== '' && !raw.includes('<' + '%')) {
                return JSON.parse(raw);
            }
        } catch(e) {
            console.warn('Parsing ' + scriptId + ' failed:', e);
        }
        return [];
    }

    albumsData = parseJsonScript('albumsDataJson');
    newsData = parseJsonScript('newsDataJson');
    bioPagesData = parseJsonScript('bioPagesJson');
    bioLinksData = parseJsonScript('bioLinksJson');
    contactMessagesData = parseJsonScript('contactMessagesJson');
    kaderQuotesData = parseJsonScript('kaderQuotesJson');
    pengurusData = parseJsonScript('pengurusDataJson');
    bidangData = parseJsonScript('bidangDataJson');
    kohatiPengurusData = parseJsonScript('kohatiPengurusDataJson');
    kohatiBidangData = parseJsonScript('kohatiBidangDataJson');
    dataAnggotaData = parseJsonScript('dataAnggotaDataJson');
    socialMediaListData = parseJsonScript('socialMediaListDataJson');
    shortlinksData = parseJsonScript('shortlinksDataJson');
    devTeamData = parseJsonScript('devTeamDataJson');
    homePillarsData = parseJsonScript('homePillarsJson');
    homeProgramsData = parseJsonScript('homeProgramsJson');
    homeMilestonesData = parseJsonScript('homeMilestonesJson');
    homeTimelineData = parseJsonScript('homeTimelineJson');
    homeFaqData = parseJsonScript('homeFaqJson');

    let quillTambah, quillEdit;
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Cek URL parameter tab untuk auto-buka tab yang dituju
        const urlParams = new URLSearchParams(window.location.search);
        const targetTab = urlParams.get('tab');
        if (targetTab && document.getElementById(targetTab)) {
            openAdmTab(targetTab);
        } else {
            openAdmTab('adm-overview');
        }

        // Inisialisasi Analitik Overview
        if (typeof initOverviewTrafficChart === 'function') {
            initOverviewTrafficChart();
        }
        initOverviewDistributionChart();
        fetchAnalyticsData();
        document.querySelectorAll('.ovw-prog-bar[data-progress]').forEach(el => {
            el.style.width = el.getAttribute('data-progress') + '%';
        });

        const savedSidebarState = localStorage.getItem('hmi_admin_sidebar_collapsed');
        if (savedSidebarState === 'true') {
            const container = document.getElementById('adminDashboardContainer');
            const icon = document.getElementById('sidebarCollapseIcon');
            if (container) container.classList.add('sidebar-collapsed');
            if (icon) icon.setAttribute('data-lucide', 'panel-left-open');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        if (document.getElementById('editorBeritaTambah')) {
            quillTambah = new Quill('#editorBeritaTambah', {
                theme: 'snow',
                placeholder: 'Tulis isi konten berita...',
                modules: { toolbar: [['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['link', 'clean']] }
            });
        }
        if (document.getElementById('editorBeritaEdit')) {
            quillEdit = new Quill('#editorBeritaEdit', {
                theme: 'snow',
                placeholder: 'Tulis isi konten berita...',
                modules: { toolbar: [['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['link', 'clean']] }
            });
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                    const anyActive = document.querySelector('.modal-overlay.active');
                    if (!anyActive) {
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                    }
                }
            });
        });
    });

    function autoGenerateSlug(sourceInputId, targetInputId) {
        const source = document.getElementById(sourceInputId);
        const target = document.getElementById(targetInputId);
        if (!source || !target) return;
        
        if (!target.dataset.touched || target.value.trim() === '') {
            target.value = source.value
                .toLowerCase()
                .trim()
                .replace(/[^\w\s-]/g, '')
                .replace(/[\s_-]+/g, '-')
                .replace(/^-+|-+$/g, '');
        }
    }

    document.getElementById('tambahBeritaSlug')?.addEventListener('input', function() {
        this.dataset.touched = 'true';
    });

    function toggleAdminSidebar() {
        const container = document.getElementById('adminDashboardContainer');
        const icon = document.getElementById('sidebarCollapseIcon');
        if (!container) return;

        const isCollapsed = container.classList.toggle('sidebar-collapsed');
        localStorage.setItem('hmi_admin_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        
        if (icon) {
