<!-- ==============================================================
     MODALS DATA INJECTION & LOGIC
============================================================== -->
<script id="albumsDataJson" type="application/json"><%- typeof albums !== 'undefined' ? JSON.stringify(albums).replace(/</g, '\\u003c') : '[]' %></script>
<script id="newsDataJson" type="application/json"><%- typeof news !== 'undefined' ? JSON.stringify(news).replace(/</g, '\\u003c') : '[]' %></script>
<script id="bioPagesJson" type="application/json"><%- typeof bioPages !== 'undefined' ? JSON.stringify(bioPages).replace(/</g, '\\u003c') : '[]' %></script>
<script id="bioLinksJson" type="application/json"><%- typeof bioLinks !== 'undefined' ? JSON.stringify(bioLinks).replace(/</g, '\\u003c') : '[]' %></script>

<script>
    let albumsData = []; 
    let newsData = [];
    let bioPagesData = [];
    let bioLinksData = [];

    try {
        const rawAlbums = document.getElementById('albumsDataJson').textContent;
        const rawNews = document.getElementById('newsDataJson').textContent;
        const rawBioPages = document.getElementById('bioPagesJson').textContent;
        const rawBioLinks = document.getElementById('bioLinksJson').textContent;

        if (rawAlbums && rawAlbums.trim() !== '' && !rawAlbums.includes('<' + '%')) albumsData = JSON.parse(rawAlbums);
        if (rawNews && rawNews.trim() !== '' && !rawNews.includes('<' + '%')) newsData = JSON.parse(rawNews);
        if (rawBioPages && rawBioPages.trim() !== '' && !rawBioPages.includes('<' + '%')) bioPagesData = JSON.parse(rawBioPages);
        if (rawBioLinks && rawBioLinks.trim() !== '' && !rawBioLinks.includes('<' + '%')) bioLinksData = JSON.parse(rawBioLinks);
    } catch(e) { console.warn('Parsing EJS data failed:', e); }

    let quillTambah, quillEdit;
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof lucide !== 'undefined') lucide.createIcons();

        if (document.getElementById('editorBeritaTambah')) {
            quillTambah = new Quill('#editorBeritaTambah', {
                theme: 'snow',
                placeholder: 'Tulis isi konten berita...',
                modules: { toolbar: [['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['link', 'clean']] }
            });
        }
        if (document.getElementById('editorBeritaEdit')) {
            quillEdit = new Quill('#editorBeritaEdit', {
                theme: 'snow',
                placeholder: 'Tulis isi konten berita...',
                modules: { toolbar: [['bold', 'italic', 'underline'], [{'list': 'ordered'}, {'list': 'bullet'}], ['link', 'clean']] }
            });
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('active');
            });
        });
    });

    function syncQuill(editorId, inputId) {
        if (editorId === 'editorBeritaTambah' && quillTambah) {
            document.getElementById(inputId).value = quillTambah.root.innerHTML;
        } else if (editorId === 'editorBeritaEdit' && quillEdit) {
            document.getElementById(inputId).value = quillEdit.root.innerHTML;
        }
    }

    function openAdmTab(tabId, btn) {
        document.querySelectorAll('.admin-tab-pane').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('active'));
        const target = document.getElementById(tabId);
        if (target) target.classList.add('active');
        if (btn) btn.classList.add('active');
        window.dispatchEvent(new Event('resize'));
    }

    function openModal(modalId) { 
        const el = document.getElementById(modalId);
        if (el) {
            el.classList.add('active');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        } else {
            console.error('Modal tidak ditemukan: ' + modalId);
        }
    }

    function closeModal(modalId) { 
        const el = document.getElementById(modalId);
        if (el) el.classList.remove('active'); 
    }

    function openEditBeritaModal(id, title, category, date) {
        document.getElementById('editBeritaTitle').value = title;
        document.getElementById('editBeritaCategory').value = category;
        document.getElementById('editBeritaDate').value = date;
        const rawContentEl = document.getElementById('raw-content-' + id);
        if (rawContentEl && quillEdit) {
            quillEdit.root.innerHTML = rawContentEl.innerHTML;
        }
        document.getElementById('formEditBerita').action = '/admin/edit-berita/' + id;
        openModal('modalEditBerita');
    }

    function openKelolaFotoBerita(beritaId) {
        const item = newsData.find(n => n.id == beritaId);
        const container = document.getElementById('containerFotoBerita');
        container.innerHTML = '';
        document.getElementById('formTambahFotoBerita').action = '/admin/tambah-foto-berita/' + beritaId;

        if (item && item.photos && item.photos.length > 0) {
            item.photos.forEach(photo => {
                const div = document.createElement('div');
                div.style.position = 'relative';
                div.innerHTML = `
                    <img src="${photo.url}" style="width:100%; height:80px; object-fit:cover; border-radius:6px; border:1px solid rgba(255,255,255,0.2);">
                    <form action="/admin/hapus-foto-berita/${beritaId}/${photo.id}" method="POST" style="position:absolute; top:2px; right:2px;">
                        <button type="submit" style="background:rgba(239,68,68,0.8); border:none; color:#fff; border-radius:4px; padding:2px 5px; cursor:pointer;" onclick="return confirm('Hapus foto?')">×</button>
                    </form>
                `;
                container.appendChild(div);
            });
        } else {
            container.innerHTML = '<p style="grid-column: 1/-1; text-align:center; color:#9ca3af; font-size:0.85rem;">Belum ada foto dokumentasi tambahan.</p>';
        }
        openModal('modalKelolaFotoBerita');
    }

    function openEditAlbumModal(id, title, date) {
        document.getElementById('editAlbumTitle').value = title;
        document.getElementById('editAlbumDate').value = date;
        document.getElementById('formEditAlbum').action = '/admin/edit-album/' + id;
        openModal('modalEditAlbum');
    }

    function openKelolaFotoAlbum(albumId) {
        const item = albumsData.find(a => a.id == albumId);
        const container = document.getElementById('containerFotoAlbum');
        container.innerHTML = '';
        document.getElementById('formTambahFotoAlbum').action = '/admin/tambah-foto-album/' + albumId;

        if (item && item.photos && item.photos.length > 0) {
            item.photos.forEach(photo => {
                const div = document.createElement('div');
                div.style.position = 'relative';
                div.innerHTML = `
                    <img src="${photo.url}" style="width:100%; height:80px; object-fit:cover; border-radius:6px; border:1px solid rgba(255,255,255,0.2);">
                    <form action="/admin/hapus-foto-album/${albumId}/${photo.id}" method="POST" style="position:absolute; top:2px; right:2px;">
                        <button type="submit" style="background:rgba(239,68,68,0.8); border:none; color:#fff; border-radius:4px; padding:2px 5px; cursor:pointer;" onclick="return confirm('Hapus foto ini?')">×</button>
                    </form>
                `;
                container.appendChild(div);
            });
        } else {
            container.innerHTML = '<p style="grid-column: 1/-1; text-align:center; color:#9ca3af; font-size:0.85rem;">Belum ada foto dalam album ini.</p>';
        }
        openModal('modalKelolaFotoAlbum');
    }

    function openEditDataAnggotaModal(id, title, date) {
        document.getElementById('editDataAnggotaTitle').value = title;
        document.getElementById('editDataAnggotaDate').value = date;
        document.getElementById('formEditDataAnggota').action = '/admin/edit-data-anggota/' + id;
        openModal('modalEditDataAnggota');
    }

    function openEditBioPageModal(id, path, bio, bgType, bgValue) {
        document.getElementById('editBioPath').value = path;
        const rawTitle = document.getElementById('raw-bio-title-' + id);
        document.getElementById('editBioTitle').value = rawTitle ? rawTitle.innerText.trim() : '';
        document.getElementById('editBioDesc').value = bio;
        document.getElementById('editBioBgGradient').value = bgType === 'gradient' ? bgValue : 'linear-gradient(135deg, #064e3b 0%, #111827 100%)';
        document.getElementById('formEditBioPage').action = '/admin/edit-bio-page/' + id;
        openModal('modalEditBioPage');
    }

    function openEditBioLinkModal(id, bioPageId, url) {
        document.getElementById('editBioLinkPageId').value = bioPageId;
        const rawTitle = document.getElementById('raw-link-title-' + id);
        document.getElementById('editBioLinkTitle').value = rawTitle ? rawTitle.innerText.trim() : '';
        document.getElementById('editBioLinkUrl').value = url;
        document.getElementById('formEditBioLink').action = '/admin/edit-biolink/' + id;
        openModal('modalEditBioLink');
    }

    function openEditShortlinkModal(id, title, path, originalUrl) {
        document.getElementById('editShortlinkTitle').value = title;
        document.getElementById('editShortlinkPath').value = path;
        document.getElementById('editShortlinkOriginalUrl').value = originalUrl;
        document.getElementById('formEditShortlink').action = '/admin/edit-shortlink/' + id;
        openModal('modalEditShortlink');
    }

    function openEditSosmedModal(id, name, url) {
        document.getElementById('editSosmedName').value = name;
        document.getElementById('editSosmedUrl').value = url;
        document.getElementById('formEditSosmed').action = '/admin/edit-sosmed/' + id;
        openModal('modalEditSosmed');
    }

    function openEditDynamic(id, name, role, actionPath, ig='', fb='', twitter='', linkedin='', tiktok='') {
        document.getElementById('editDynamicName').value = name;
        document.getElementById('editDynamicRole').value = role;
        document.getElementById('editDynamicIg').value = ig;
        document.getElementById('editDynamicFb').value = fb;
        document.getElementById('editDynamicTwitter').value = twitter;
        document.getElementById('editDynamicLinkedin').value = linkedin;
        document.getElementById('editDynamicTiktok').value = tiktok;
        document.getElementById('formEditDynamic').action = actionPath + id;
        openModal('modalEditDynamic');
    }

    function openEditBidangModal(id, name, actionPath) { 
        document.getElementById('editBidangName').value = name; 
        document.getElementById('formEditBidang').action = actionPath + id; 
        openModal('modalEditBidang'); 
    }
    
    function openModalAnggotaBidang(bidangId, bidangName, actionPath) { 
        document.getElementById('anggotaBidangTitle').innerText = "Tambah Anggota: " + bidangName; 
        document.getElementById('editAnggotaBidangName').value = "";
        document.getElementById('editAnggotaBidangRole').value = ""; 
        document.getElementById('editAnggotaBidangIg').value = "";
        document.getElementById('editAnggotaBidangFb').value = "";
        document.getElementById('editAnggotaBidangTwitter').value = "";
        document.getElementById('editAnggotaBidangLinkedin').value = "";
        document.getElementById('editAnggotaBidangTiktok').value = "";
        document.getElementById('formAnggotaBidang').action = actionPath + bidangId; 
        openModal('modalAnggotaBidang'); 
    }
    
    function openEditAnggotaBidangModal(bidangId, memberId, name, role, actionPath, ig='', fb='', twitter='', linkedin='', tiktok='') { 
        document.getElementById('anggotaBidangTitle').innerText = "Edit Anggota"; 
        document.getElementById('editAnggotaBidangName').value = name; 
        document.getElementById('editAnggotaBidangRole').value = role; 
        document.getElementById('editAnggotaBidangIg').value = ig;
        document.getElementById('editAnggotaBidangFb').value = fb;
        document.getElementById('editAnggotaBidangTwitter').value = twitter;
        document.getElementById('editAnggotaBidangLinkedin').value = linkedin;
        document.getElementById('editAnggotaBidangTiktok').value = tiktok;
        document.getElementById('formAnggotaBidang').action = actionPath + bidangId + "/" + memberId; 
        openModal('modalAnggotaBidang'); 
    }

    function openEditDevTeamModal(id, name, role, dept, category, ig, isProtected) {
        document.getElementById('editDevName').value = name;
        document.getElementById('editDevRole').value = role;
        document.getElementById('editDevDept').value = dept;
        document.getElementById('editDevCategory').value = category;
        document.getElementById('editDevIg').value = ig;
        
        const pinGroup = document.getElementById('pinGroupDev');
        const pinInput = document.getElementById('editDevPin');
        if(isProtected) {
            pinGroup.style.display = 'block';
            pinInput.required = true;
            pinInput.value = '';
        } else {
            pinGroup.style.display = 'none';
            pinInput.required = false;
            pinInput.value = '';
        }

        document.getElementById('formEditDevTeam').action = '/admin/edit-devteam/' + id;
        openModal('modalEditDevTeam');
    }

    function handleProtectedDelete(event, isProtected) {
        if (isProtected) {
            const pin = prompt("PERINGATAN SISTEM!\nMenghapus Lead Developer membutuhkan PIN Otorisasi.\n\nMasukkan PIN Rahasia:");
            if (pin !== '999') {
                alert("AKSES DITOLAK! PIN Salah atau Dibatalkan.");
                event.preventDefault();
                return false;
            }
            const form = event.target;
            const hiddenPin = document.createElement('input');
            hiddenPin.type = 'hidden';
            hiddenPin.name = 'pin';
            hiddenPin.value = pin;
            form.appendChild(hiddenPin);
        }
        return confirm('Hapus profil developer ini secara permanen?');
    }

    async function compressImage(file, maxWidth = 1000) {
        return new Promise((resolve) => {
            const reader = new FileReader(); 
            reader.readAsDataURL(file);
            reader.onload = (event) => {
                const img = new Image(); 
                img.src = event.target.result;
                img.onload = () => {
                    const canvas = document.createElement('canvas'); 
                    let width = img.width; 
                    let height = img.height;
                    if (width > maxWidth) { 
                        height = Math.round((height * maxWidth) / width); 
                        width = maxWidth; 
                    }
                    canvas.width = width; 
                    canvas.height = height; 
                    const ctx = canvas.getContext('2d'); 
                    ctx.drawImage(img, 0, 0, width, height);
                    resolve(canvas.toDataURL('image/webp', 0.6)); 
                };
            };
        });
    }

    document.querySelectorAll('.file-compress').forEach(input => {
        input.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file && file.type.startsWith('image/')) {
                const submitBtn = input.closest('form').querySelector('.submit-btn');
                const originalText = submitBtn ? submitBtn.innerText : ''; 
                if (submitBtn) {
                    submitBtn.innerText = 'Mengompresi Gambar...'; 
                    submitBtn.disabled = true;
                }
                const base64 = await compressImage(file);
                let hidden = input.parentElement.querySelector('.b64-hidden');
                if (!hidden) { 
                    hidden = document.createElement('input'); 
                    hidden.type = 'hidden'; 
                    hidden.name = input.name + '_b64'; 
                    hidden.className = 'b64-hidden'; 
                    input.parentElement.appendChild(hidden); 
                }
                hidden.value = base64; 
                if (submitBtn) {
                    submitBtn.innerText = originalText; 
                    submitBtn.disabled = false;
                }
            }
        });
    });

    document.querySelectorAll('.file-to-b64').forEach(input => {
        input.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    let hidden = input.parentElement.querySelector('.b64-hidden');
                    if (!hidden) {
                        hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = input.name + '_b64';
                        hidden.className = 'b64-hidden';
                        input.parentElement.appendChild(hidden);
                    }
                    hidden.value = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    });
</script>
