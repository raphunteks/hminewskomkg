        <div class="modal-header"><h3>Tambah Berita Baru</h3><button type="button" class="close-modal" onclick="closeModal('modalBerita')"><i data-lucide="x"></i></button></div>
        <form action="/admin/tambah-berita" method="POST" enctype="multipart/form-data" onsubmit="syncQuill('editorBeritaTambah', 'contentBeritaTambah')">
