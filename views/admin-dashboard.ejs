                                        <button type="button" class="action-btn delete" disabled style="opacity:0.5; cursor:not-allowed;"><i data-lucide="trash-2"></i></button>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
