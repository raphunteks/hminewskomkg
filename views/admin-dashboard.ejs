                            <div class="form-group"><label>Teks Misi Umum</label><textarea name="misiText" class="input-control" rows="4"><%= cleanText(siteSettings.misiText) %></textarea></div>

                            <div class="form-group" style="margin-top:25px; background: rgba(0,0,0,0.03); padding: 15px; border-radius: 12px; border: 1px dashed var(--theme-glass-border);">
                                <label style="color:#16a34a; font-size:1rem; border-bottom:1px solid var(--theme-glass-border); padding-bottom:8px;">Upload Booklet / Pedoman PDF</label>
                                <p class="text-muted" style="font-size:0.8rem; margin-bottom: 12px;">Pilih salah satu metode di bawah. Disarankan menggunakan Link Google Drive.</p>
