<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SCRIPT ANTI-FLICKER TEMA (MEMASTIKAN TEMA TERAPLIKASI SEBELUM DOM DI-RENDER) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('hmi_theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <!-- CORE CSS - DITARUH DI AWAL HEAD AGAR DITERAPKAN INSTAN TANPA FOUC / UNSTYLED HTML -->
    <link rel="stylesheet" href="/css/main.css">

    <!-- PRECONNECT & FONTS -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap">

    <meta name="google-site-verification" content="lV4veWnfsXOsnHBVIUxj7uQUA_jdJIQ6Guk4bPGFGHc" />

    <% 
    // ==============================================================
    // 100% DYNAMIC SSR SEO ENGINE - GOLD STANDARD GOOGLE SEARCH CONSOLE
    // ==============================================================
    const baseUrl = 'https://www.hmikomkgumi.xyz';
    const safeSettings = typeof siteSettings !== 'undefined' && siteSettings ? siteSettings : {};
    
    const siteBrand = (safeSettings.headerTitle ? (safeSettings.headerTitle + ' ' + (safeSettings.headerHighlight || '')).trim() : 'HMI KomKG UMI') || 'HMI KomKG UMI';
    const defaultSiteTitle = safeSettings.heroTitle || safeSettings.webTitle || siteBrand;
    
    // Default SEO Fallbacks
    let finalTitle = defaultSiteTitle;
    let finalDesc = safeSettings.seoDescription || 'Website Resmi Himpunan Mahasiswa Islam (HMI) Komisariat Kedokteran Gigi Universitas Muslim Indonesia. Wadah kader insan akademis, pencipta, dan pengabdi bernafaskan Islam.';
    let finalImage = safeSettings.seoImage || safeSettings.headerLogo || '/img/logo-hmikomkgumi.png';
    let finalType = 'website';
    let finalUrl = baseUrl + '/';
    let finalDate = new Date().toISOString();
    let finalCategory = 'Organisasi Mahasiswa';
    let isNoIndex = (typeof noIndex !== 'undefined' && noIndex === true) || (typeof page !== 'undefined' && (page === 'admin' || page === '404'));

    // Breadcrumb state tracker
    let breadcrumbName = 'Beranda';
    let hasBreadcrumbParent = false;
    let breadcrumbParentName = '';
    let breadcrumbParentUrl = '';

    // 1. AUTO-DETEKSI DETAIL BERITA (SSR ARTICLE)
    if (typeof berita !== 'undefined' && berita && berita.title) {
        finalTitle = berita.title + ' | ' + siteBrand;
        if (berita.content) {
            finalDesc = berita.content.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
            if (finalDesc.length > 155) {
                finalDesc = finalDesc.substring(0, 155) + '...';
            }
        }
        if (berita.image) finalImage = berita.image;
        finalType = 'article';
        finalDate = berita.date || finalDate;
        finalCategory = berita.category || 'Berita & Informasi';
        const bSlug = berita.slug || berita.id;
        finalUrl = baseUrl + '/berita/' + encodeURIComponent(bSlug);

        hasBreadcrumbParent = true;
        breadcrumbParentName = 'Berita';
        breadcrumbParentUrl = baseUrl + '/';
        breadcrumbName = berita.title;
    } 
    // 2. AUTO-DETEKSI DETAIL GALERI (SSR IMAGE GALLERY)
    else if (typeof album !== 'undefined' && album && album.title) {
        finalTitle = 'Galeri: ' + album.title + ' | ' + siteBrand;
        finalDesc = 'Dokumentasi foto kegiatan ' + album.title + ' HMI Komisariat Kedokteran Gigi UMI pada ' + (album.date || '') + '. Lihat seluruh momen kader di sini.';
        if (album.cover) finalImage = album.cover;
        finalType = 'article';
        finalDate = album.date || finalDate;
        finalCategory = 'Galeri Kegiatan';
        finalUrl = baseUrl + '/galeri/' + album.id;

        hasBreadcrumbParent = true;
        breadcrumbParentName = 'Galeri';
        breadcrumbParentUrl = baseUrl + '/galeri';
        breadcrumbName = album.title;
    } 
    // 3. AUTO-DETEKSI PARAMETER MANUAL (DARI VIEW TENTANG, GALERI, DATA-ANGGOTA, DLL)
    else if (typeof pageTitle !== 'undefined' && pageTitle) {
        finalTitle = pageTitle + ' | ' + siteBrand;
        if (typeof pageDescription !== 'undefined' && pageDescription) finalDesc = pageDescription;
        if (typeof pageImage !== 'undefined' && pageImage) finalImage = pageImage;
        if (typeof pageType !== 'undefined' && pageType) finalType = pageType;
        
        if (typeof page !== 'undefined' && page && page !== 'beranda') {
            finalUrl = baseUrl + '/' + page;
            breadcrumbName = pageTitle;
        }
    } else if (typeof page !== 'undefined' && page && page !== 'beranda') {
        const capitalized = page.charAt(0).toUpperCase() + page.slice(1);
        finalTitle = capitalized + ' | ' + siteBrand;
        finalUrl = baseUrl + '/' + page;
        breadcrumbName = capitalized;
    }

    // Override Canonical URL jika diberikan eksplisit
    if (typeof canonicalUrl !== 'undefined' && canonicalUrl) {
        finalUrl = canonicalUrl;
    }

    // Standardisasi URL Kanonikal
    if (finalUrl.startsWith('/')) {
        finalUrl = baseUrl + finalUrl;
    }

    // Standardisasi URL Gambar Absolut (Kunci Utama Pratinjau WhatsApp, FB, X/Twitter Besar)
    // Crawler sosial (WA, FB, Twitter) WAJIB menerima URL HTTP/HTTPS publik, bukan Base64 data:
    // WA memiliki batas ketat maksimal 300KB agar gambar pratinjau muncul di chat.
    // Kami sediakan og-image.png (152 KB, 500x500) yang 100% kompatibel di semua sosial media.
    const defaultOgImage = baseUrl + '/img/og-image.png';
    if (!finalImage || finalImage.startsWith('data:') || finalImage.includes('logo-hmikomkgumi.png')) {
        finalImage = defaultOgImage;
    } else if (!finalImage.startsWith('http')) {
        finalImage = baseUrl + (finalImage.startsWith('/') ? '' : '/') + finalImage;
    }

    // Standardisasi Kata Kunci Dinamis
    let finalKeywords = safeSettings.seoKeywords || 'hmi komkg umi, hmikomkgumi, hmi, hmi kom kg umi, hmi kedokteran gigi umi, fkg umi makassar, yakusa, yakin usaha sampai, hmi cabang makassar';
    if (typeof pageKeywords !== 'undefined' && pageKeywords) {
        finalKeywords = pageKeywords + ', ' + finalKeywords;
    } else if (finalType === 'article') {
        finalKeywords = finalCategory + ', Berita HMI, Kegiatan HMI KomKG UMI, ' + finalKeywords;
    }
    %>

    <!-- 1. PRIMARY META TAGS (SSR DINAMIS 100%) -->
    <title><%= finalTitle %></title>
    <meta name="title" content="<%= finalTitle %>">
    <meta name="description" content="<%= finalDesc %>">
    <meta name="keywords" content="<%= finalKeywords %>">
    <meta name="author" content="<%= siteBrand %>">

    <!-- FAVICON & APP ICONS (COMPATIBLE LOCALHOST & PRODUCTION, GOLD STANDARD W3C) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#064e3b">

    <!-- 2. ROBOTS & CRAWLER DIRECTIVES (GOLD STANDARD GSC) -->
    <% if (isNoIndex) { %>
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="googlebot" content="noindex, nofollow, noarchive">
    <% } else { %>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <% } %>

    <!-- 3. CANONICAL & HREFLANG -->
    <link rel="canonical" href="<%= finalUrl %>">
    <link rel="alternate" hreflang="id" href="<%= finalUrl %>">
    <link rel="alternate" hreflang="x-default" href="<%= finalUrl %>">

    <!-- 4. OPEN GRAPH / FACEBOOK / WHATSAPP / INSTAGRAM / TELEGRAM / LINKEDIN -->
    <meta property="og:locale" content="id_ID">
    <meta property="og:type" content="<%= finalType %>">
    <meta property="og:title" content="<%= finalTitle %>">
    <meta property="og:description" content="<%= finalDesc %>">
    <meta property="og:url" content="<%= finalUrl %>">
    <meta property="og:site_name" content="<%= siteBrand %>">
    <meta property="og:image" content="<%= finalImage %>">
    <meta property="og:image:secure_url" content="<%= finalImage %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="500">
    <meta property="og:image:alt" content="Logo Resmi <%= siteBrand %>">

    <% if (finalType === 'article') { %>
    <meta property="article:published_time" content="<%= finalDate %>">
    <meta property="article:modified_time" content="<%= finalDate %>">
    <meta property="article:author" content="<%= siteBrand %>">
    <meta property="article:section" content="<%= finalCategory %>">
    <meta property="article:tag" content="<%= finalCategory %>">
    <% } %>

    <!-- 5. TWITTER CARDS (X) -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:domain" content="www.hmikomkgumi.xyz">
    <meta name="twitter:url" content="<%= finalUrl %>">
    <meta name="twitter:title" content="<%= finalTitle %>">
    <meta name="twitter:description" content="<%= finalDesc %>">
    <meta name="twitter:image" content="<%= finalImage %>">
    <meta name="twitter:image:alt" content="Logo Resmi <%= siteBrand %>">

    <!-- 6. GOLD STANDARD GSC: BREADCRUMBLIST SCHEMA (DYNAMIC SSR) -->
    <% if (!isNoIndex) { %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": "<%= finalUrl %>#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "<%= baseUrl %>/"
        }
        <% if (hasBreadcrumbParent) { %>
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": "<%= breadcrumbParentName.replace(/"/g, '\\"') %>",
          "item": "<%= breadcrumbParentUrl %>"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "<%= breadcrumbName.replace(/"/g, '\\"') %>",
          "item": "<%= finalUrl %>"
        }
        <% } else if (typeof page !== 'undefined' && page !== 'beranda') { %>
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": "<%= breadcrumbName.replace(/"/g, '\\"') %>",
          "item": "<%= finalUrl %>"
        }
        <% } %>
      ]
    }
    </script>
    <% } %>

    <script src="https://unpkg.com/lucide@latest" defer></script>

    <script>
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script src="/_vercel/speed-insights/script.js" defer></script>

    <!-- 7. CORE STRUCTURED DATA (ORGANIZATION, WEBSITE, SITELINKS NAVIGATION) -->
    <%- include('schema') %>
</head>
<body>
    
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <nav class="glass-header">
        <div class="container navbar">
            <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Buka Menu Mobile">
                <i data-lucide="menu"></i>
            </button>

            <a href="/" class="logo-area" aria-label="Ke Beranda">
                <div class="logo-box" style="width:45px; height:45px;">
                    <img src="<%= safeSettings.headerLogo || '/img/logo-hmikomkgumi.png' %>" alt="Logo" class="logo-img" width="45" height="45" style="width:100%; max-width:45px; object-fit:contain;" fetchpriority="high">
                </div>
                <div class="logo-text">
                    <h1><%= safeSettings.headerTitle || 'HMI' %><span class="text-primary"><%= safeSettings.headerHighlight || '' %></span></h1>
                    <p><%= safeSettings.headerSubtitle || '' %></p>
                </div>
            </a>
            
            <ul class="nav-links" id="nav-links">
                <li><a href="/" class="nav-item <%= typeof page !== 'undefined' && page === 'beranda' ? 'active' : '' %>"><i data-lucide="home"></i> Beranda</a></li>
                <li><a href="/tentang" class="nav-item <%= typeof page !== 'undefined' && page === 'tentang' ? 'active' : '' %>"><i data-lucide="info"></i> Tentang</a></li>
                <li><a href="/galeri" class="nav-item <%= typeof page !== 'undefined' && page === 'galeri' ? 'active' : '' %>"><i data-lucide="image"></i> Galeri</a></li>
                <li><a href="/data-anggota" class="nav-item <%= typeof page !== 'undefined' && page === 'data-anggota' ? 'active' : '' %>"><i data-lucide="users"></i> Data Anggota</a></li>
                <li><a href="/narahubung" class="nav-item <%= typeof page !== 'undefined' && page === 'narahubung' ? 'active' : '' %>"><i data-lucide="phone-call"></i> Narahubung</a></li>
            </ul>
            
            <div class="nav-actions">
                <!-- ==============================================================
                     THEME SWITCHER BUTTON (PERSIS GAMBAR 1: LIGHT / HIJAU GELAP)
                ============================================================== -->
                <div class="theme-switch-wrapper" title="Ganti Tema">
                    <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Ganti Tema">
                        <span class="theme-sun-icon">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="4" fill="#fef3c7"></circle>
                                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                            </svg>
                        </span>
                        <span class="theme-switch-pill">
                            <span class="theme-switch-thumb"></span>
                        </span>
                    </button>
                </div>

                <a href="/admin" class="btn-icon" title="Login Admin" aria-label="Login Admin">
                    <i data-lucide="lock"></i>
                </a>
            </div>
        </div>
    </nav>
    
    <main>
        <div class="container">

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Mobile Menu Toggle
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const navLinks = document.getElementById('nav-links');
            if (mobileMenuBtn && navLinks) {
                mobileMenuBtn.addEventListener('click', function() { navLinks.classList.toggle('active'); });
            }

            // 2. Logic Theme Switcher (Sync localStorage)
            const themeBtn = document.getElementById('theme-toggle-btn');
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';

            // Set state awal tombol switch
            if (currentTheme === 'dark' && themeBtn) {
                themeBtn.classList.add('active-dark');
            }

            if (themeBtn) {
                themeBtn.addEventListener('click', function() {
                    const activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
                    const newTheme = activeTheme === 'light' ? 'dark' : 'light';
                    
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('hmi_theme', newTheme);
                    
                    if (newTheme === 'dark') {
                        themeBtn.classList.add('active-dark');
                    } else {
                        themeBtn.classList.remove('active-dark');
                    }
                });
            }
        });
    </script>
