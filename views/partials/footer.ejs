</div> <!-- Menutup div.container dari header -->
    </main> <!-- Menutup tag main dari header -->
    
    <%
        // SAFE OBJECT FALLBACK: Mencegah crash jika variabel tidak terdefinisi
        const safeSettings = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {};
        const safeSocialMedia = (typeof socialMediaList !== 'undefined' && Array.isArray(socialMediaList)) ? socialMediaList : [
            { id: 1, name: 'Instagram', icon: '', url: 'https://www.instagram.com/hmi_komkgumi' },
            { id: 2, name: 'Facebook', icon: '', url: 'https://www.facebook.com/hmi_komkgumi' }
        ];
    %>

    <!-- ==============================================================
         FOOTER UTAMA (RESPONSIF MOBILE, TABLET & DESKTOP)
    ============================================================== -->
    <footer class="site-footer" style="z-index: 10; position: relative;">
        <div class="container">
            <div class="grid-3 footer-top">
                
                <!-- KOLOM 1: LOGO & DESKRIPSI KOMISARIAT -->
                <div style="grid-column: span 1;">
                    <div class="footer-logo-area">
                        <div class="footer-logo-box">
                            <img src="<%= safeSettings.footerLogo || '/img/logo-hmikomkgumi.png' %>" alt="Logo Footer HMI" class="footer-logo-img" loading="lazy" onerror="this.src='/img/logo-hmikomkgumi.png'">
                        </div>
                        <div class="logo-text">
                            <h2 style="font-size:1.4rem; margin:0;"><%= safeSettings.footerTitle || 'Komisariat Kedokteran Gigi UMI' %></h2>
                        </div>
                    </div>
                    <p class="footer-desc"><%= safeSettings.footerDesc || 'Tempat berkembang bareng untuk generasi muslim yang progresif, intelektual, dan menjunjung tinggi nilai-nilai keislaman dan keindonesiaan dalam lingkup Kedokteran Gigi.' %></p>
                </div>
                
                <!-- KOLOM 2: MENU NAVIGASI LENGKAP -->
                <div class="footer-links">
                    <h3>Menu</h3>
                    <ul>
                        <li><a href="/">Beranda</a></li>
                        <li><a href="/tentang">Tentang Kami</a></li>
                        <li><a href="/galeri">Galeri Kegiatan</a></li>
                        <li><a href="/data-anggota">Data Anggota</a></li>
                        <li><a href="/narahubung">Narahubung</a></li>
                    </ul>
                </div>
                
                <!-- KOLOM 3: SOCIAL MEDIA INTEGRASI DATABASE KV (IG, FB, DLL) -->
                <div class="footer-links">
                    <h3>Follow Kita!</h3>
                    <div class="social-links">
                        <% safeSocialMedia.forEach(soc => { 
                            let socName = (soc.name || '').toLowerCase();
                        %>
                            <a href="<%= soc.url || '#' %>" target="_blank" class="social-btn" title="<%= soc.name %>" rel="noopener noreferrer" aria-label="<%= soc.name %>">
                                <% if(soc.icon && soc.icon.length > 0) { %>
                                    <img src="<%= soc.icon %>" alt="<%= soc.name %>" width="22" height="22" loading="lazy">
                                <% } else { %>
                                    <% if (socName.includes('instagram') || socName.includes('ig')) { %>
                                        <i data-lucide="instagram"></i>
                                    <% } else if (socName.includes('facebook') || socName.includes('fb')) { %>
                                        <i data-lucide="facebook"></i>
                                    <% } else if (socName.includes('twitter') || socName.includes('x')) { %>
                                        <i data-lucide="twitter"></i>
                                    <% } else if (socName.includes('youtube') || socName.includes('yt')) { %>
                                        <i data-lucide="youtube"></i>
                                    <% } else if (socName.includes('tiktok')) { %>
                                        <i data-lucide="tv"></i>
                                    <% } else if (socName.includes('whatsapp') || socName.includes('wa')) { %>
                                        <i data-lucide="message-circle"></i>
                                    <% } else if (socName.includes('linkedin')) { %>
                                        <i data-lucide="linkedin"></i>
                                    <% } else { %>
                                        <i data-lucide="link"></i>
                                    <% } %>
                                <% } %>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
            
            <!-- FOOTER BOTTOM & CREDITS -->
            <div class="footer-bottom">
                <span><%= safeSettings.footerCopyright || '© 2026 HMI Komisariat Kedokteran Gigi UMI. All rights reserved.' %></span>
                <span><a href="https://www.hmikomkgumi.xyz/ourteam" style="color: inherit; text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#4ade80'" onmouseout="this.style.color='inherit'"><%= safeSettings.footerProgrammer || '💻 Axa Xyz' %></a></span>
            </div>
        </div>
    </footer>

    <!-- ==============================================================
         SUPER BIG UPGRADE: TOMBOL FLOATING SCROLL TO TOP (PERSIS GAMBAR 2 & 4)
    ============================================================== -->
    <button type="button" id="btnScrollTop" class="scroll-to-top-btn" aria-label="Scroll to top" title="Kembali ke atas">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
    </button>

    <!-- SCRIPT INITIALIZER ICONS & SCROLL-TO-TOP LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Inisialisasi Ikon Lucide
            const initIcons = () => {
                if (typeof lucide !== 'undefined') { 
                    lucide.createIcons(); 
                } else {
                    setTimeout(initIcons, 100);
                }
            };
            initIcons();

            // 2. Logic Floating Scroll to Top Button
            const scrollBtn = document.getElementById('btnScrollTop');
            if (scrollBtn) {
                window.addEventListener('scroll', () => {
                    // Muncul otomatis saat di-scroll lebih dari 200px dari atas
                    if (window.scrollY > 200) {
                        scrollBtn.classList.add('visible');
                    } else {
                        scrollBtn.classList.remove('visible');
                    }
                }, { passive: true });

                scrollBtn.addEventListener('click', () => {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }
        });
    </script>
</body>
</html>
