</div> <!-- Menutup div.container dari header -->
    </main> <!-- Menutup tag main dari header -->
    
    <!-- Footer Utama -->
    <footer class="site-footer" style="z-index: 10; position: relative;">
        <div class="container">
            <div class="grid-3 footer-top">
                <div style="grid-column: span 1;">
                    <!-- UPGRADE 1: Class footer-logo-box digunakan tanpa membatasi dengan inline max-width 40px -->
                    <div class="footer-logo-area">
                        <div class="footer-logo-box">
                            <img src="<%= siteSettings.footerLogo %>" alt="Logo" class="footer-logo-img" loading="lazy">
                        </div>
                        <div class="logo-text">
                            <h2 style="font-size:1.4rem; margin:0;"><%= siteSettings.footerTitle %></h2>
                        </div>
                    </div>
                    <p class="footer-desc"><%= siteSettings.footerDesc %></p>
                </div>
                
                <div class="footer-links">
                    <h3>Menu</h3>
                    <ul>
                        <li><a href="/">Beranda</a></li>
                        <li><a href="/tentang">Tentang Kami</a></li>
                        <li><a href="/galeri">Galeri Kegiatan</a></li>
                        <li><a href="/data-anggota">Data Anggota</a></li>
                        <li><a href="/narahubung">Narahubung</a></li>
                    </ul>
                </div>
                
                <div class="footer-links">
                    <h3>Follow Kita!</h3>
                    <div class="social-links">
                        <% socialMediaList.forEach(soc => { %>
                            <a href="<%= soc.url %>" target="_blank" class="social-btn" title="<%= soc.name %>" rel="noopener noreferrer">
                                <% if(soc.icon && soc.icon.length > 0) { %>
                                    <img src="<%= soc.icon %>" alt="<%= soc.name %>" width="22" height="22" loading="lazy">
                                <% } else { %>
                                    <% if (soc.name.toLowerCase().includes('instagram') || soc.name.toLowerCase().includes('ig')) { %>
                                        <i data-lucide="instagram"></i>
                                    <% } else if (soc.name.toLowerCase().includes('facebook') || soc.name.toLowerCase().includes('fb')) { %>
                                        <i data-lucide="facebook"></i>
                                    <% } else if (soc.name.toLowerCase().includes('twitter') || soc.name.toLowerCase().includes('x')) { %>
                                        <i data-lucide="twitter"></i>
                                    <% } else if (soc.name.toLowerCase().includes('youtube') || soc.name.toLowerCase().includes('yt')) { %>
                                        <i data-lucide="youtube"></i>
                                    <% } else if (soc.name.toLowerCase().includes('tiktok')) { %>
                                        <i data-lucide="tv"></i>
                                    <% } else { %>
                                        <i data-lucide="link"></i>
                                    <% } %>
                                <% } %>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <span><%= siteSettings.footerCopyright %></span>
                <span><a href="https://www.hmikomkgumi.xyz/ourteam" style="color: inherit; text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#4ade80'" onmouseout="this.style.color='inherit'"><%= siteSettings.footerProgrammer %></a></span>
            </div>
        </div>
    </footer>

    <!-- ==============================================================
         SUPER BIG UPGRADE: TOMBOL FLOATING SCROLL TO TOP (PERSIS GAMBAR 2 & 4)
    ============================================================== -->
    <button type="button" id="btnScrollTop" class="scroll-to-top-btn" aria-label="Scroll to top" title="Kembali ke atas">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
    </button>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Inisialisasi Ikon Lucide
            const initIcons = () => {
                if (typeof lucide !== 'undefined') { 
                    lucide.createIcons(); 
                } else {
                    setTimeout(initIcons, 100);
                }
            };
            initIcons();

            // 2. Logic Floating Scroll to Top Button
            const scrollBtn = document.getElementById('btnScrollTop');
            if (scrollBtn) {
                window.addEventListener('scroll', () => {
                    if (window.scrollY > 200) {
                        scrollBtn.classList.add('visible');
                    } else {
                        scrollBtn.classList.remove('visible');
                    }
                }, { passive: true });

                scrollBtn.addEventListener('click', () => {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }
        });
    </script>
</body>
</html>
