<% 
    // ==============================================================
    // SUPER BIG UPGRADE: ERROR 500 PREVENTION (BULLETPROOF EJS)
    // Mencegah server Node.js crash jika ID Berita tidak ditemukan/dihapus
    // ==============================================================
    let safeBerita = (typeof berita !== 'undefined' && berita) ? berita : {
        id: '404',
        title: 'Berita Tidak Ditemukan',
        content: '<p>Mohon maaf, konten berita telah dihapus atau tidak tersedia.</p>',
        image: '/img/logo-hmikomkgumi.png',
        category: 'Umum',
        date: new Date().toLocaleDateString('id-ID'),
        photos: []
    };

    let pageTitle = safeBerita.title;
    
    // SMART UPGRADE: Membersihkan tag HTML dari konten untuk meta description (max 150 chars)
    let rawContent = safeBerita.content || "";
    let cleanDesc = rawContent.replace(/<[^>]+>/g, '').replace(/\n/g, ' ').trim();
    let pageDescription = cleanDesc.length > 150 ? cleanDesc.substring(0, 150) + "..." : (cleanDesc || "Baca informasi terbaru dari HMI KomKG UMI.");
    
    // Standarisasi Base URL dan URL Gambar Absolute
    const seoBaseUrl = 'https://www.hmikomkgumi.xyz';
    let rawImage = safeBerita.image || '/img/logo-hmikomkgumi.png';
    let absoluteImage = rawImage.startsWith('http') ? rawImage : seoBaseUrl + (rawImage.startsWith('/') ? '' : '/') + rawImage;
    let articleUrl = seoBaseUrl + "/berita/" + safeBerita.id;
%>
<%- include('partials/header', { pageTitle: pageTitle, pageDescription: pageDescription }) %>

<!-- ==============================================================
     SUPER BIG UPGRADE SEO & ANTI-ERROR PRATINJAU (PREVIEW-SAFE)
     Mengubah cara injeksi variabel EJS agar tidak bertabrakan dengan JS Parser.
     Semua data server-side (EJS) ditampung di dalam HTML DOM terlebih dahulu.
============================================================== -->
<div id="seo-server-data" 
     style="display:none;" 
     data-title="<%= pageTitle %>" 
     data-desc="<%= pageDescription %>" 
     data-url="<%= articleUrl %>" 
     data-img="<%= absoluteImage %>" 
     data-cat="<%= safeBerita.category %>" 
     data-date="<%= safeBerita.date %>"
     data-baseurl="<%= seoBaseUrl %>">
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. MENGAMBIL DATA DARI DOM (Sangat Aman untuk fitur Pratinjau tanpa memicu SyntaxError)
    const seoDataEl = document.getElementById('seo-server-data');
    if(!seoDataEl) return;
    
    const d_title = seoDataEl.getAttribute('data-title');
    const d_desc = seoDataEl.getAttribute('data-desc');
    const d_url = seoDataEl.getAttribute('data-url');
    const d_img = seoDataEl.getAttribute('data-img');
    const d_cat = seoDataEl.getAttribute('data-cat');
    const d_date = seoDataEl.getAttribute('data-date');
    const d_baseurl = seoDataEl.getAttribute('data-baseurl');

    const metaTags = [
        { name: "description", content: d_desc },
        { name: "keywords", content: `${d_cat}, Berita HMI, Proker HMI KomKG UMI, Kedokteran Gigi UMI, Organisasi FKG UMI` },
        { name: "author", content: "Admin HMI KomKG UMI" },
        { name: "robots", content: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" },
        
        // Open Graph (WhatsApp, FB, IG)
        { property: "og:title", content: d_title + " | HMI KomKG UMI" },
        { property: "og:description", content: d_desc },
        { property: "og:type", content: "article" }, 
        { property: "og:url", content: d_url },
        { property: "og:image", content: d_img },
        { property: "og:site_name", content: "HMI KomKG UMI" },
        
        // Twitter Cards
        { property: "twitter:card", content: "summary_large_image" },
        { property: "twitter:title", content: d_title + " | HMI KomKG UMI" },
        { property: "twitter:description", content: d_desc },
        { property: "twitter:image", content: d_img }
    ];

    // Injeksi Link Canonical untuk Google Search Console
    let canonical = document.createElement('link');
    canonical.rel = 'canonical';
    canonical.href = d_url;
    document.head.appendChild(canonical);

    // Injeksi Meta Tags ke tag <head>
    metaTags.forEach(tag => {
        let selector = tag.name ? `meta[name="${tag.name}"]` : `meta[property="${tag.property}"]`;
        let existingTag = document.head.querySelector(selector);
        if (!existingTag) {
            let el = document.createElement('meta');
            if(tag.name) el.name = tag.name;
            if(tag.property) el.setAttribute('property', tag.property);
            el.content = tag.content;
            document.head.appendChild(el);
        } else {
            existingTag.content = tag.content;
        }
    });

    // ==============================================================
    // 2. INJEKSI JSON-LD (ARTICLE) SECARA DINAMIS (PREVIEW-SAFE)
    // ==============================================================
    const jsonLdData = {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": `${d_url}/#webpage`,
          "url": d_url,
          "name": `${d_title} | HMI KomKG UMI`,
          "description": d_desc,
          "inLanguage": "id-ID",
          "isPartOf": { "@id": `${d_baseurl}/#website` }
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${d_url}/#breadcrumb`,
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${d_baseurl}/` },
            { "@type": "ListItem", "position": 2, "name": "Berita & Informasi", "item": `${d_baseurl}/#news-list` },
            { "@type": "ListItem", "position": 3, "name": d_title, "item": d_url }
          ]
        },
        {
          "@type": "NewsArticle",
          "@id": `${d_url}/#article`,
          "headline": d_title,
          "description": d_desc,
          "image": d_img,
          "datePublished": d_date,
          "author": { "@type": "Organization", "name": "Admin HMI KomKG UMI", "url": d_baseurl },
          "publisher": { 
              "@type": "Organization", 
              "name": "HMI KomKG UMI", 
              "logo": { "@type": "ImageObject", "url": `${d_baseurl}/img/logo-hmikomkgumi.png` } 
          },
          "mainEntityOfPage": { "@type": "WebPage", "@id": `${d_url}/#webpage` },
          "articleSection": d_cat
        }
      ]
    };

    const jsonLdScript = document.createElement('script');
    jsonLdScript.type = 'application/ld+json';
    jsonLdScript.textContent = JSON.stringify(jsonLdData);
    document.head.appendChild(jsonLdScript);
});
</script>
<script src="/js/protect-devtools.js" defer></script>

<div class="container" style="max-width: 800px; margin-bottom: 50px;">
    
    <!-- Tombol Kembali -->
    <a href="/" style="color: var(--theme-primary); display:inline-flex; align-items:center; gap:6px; margin-bottom:20px; font-weight:700; transition:0.3s ease;">
        <i data-lucide="arrow-left" style="width:18px;"></i> Kembali ke Beranda
    </a>

    <!-- ==============================================================
         SUPER BIG UPGRADE: EXPERT SEO MICRODATA (SCHEMA.ORG)
    ============================================================== -->
    <article class="glass" itemscope itemtype="https://schema.org/NewsArticle" style="padding: 40px; border-top: 5px solid #22c55e;">
        
        <!-- Kategori -->
        <span class="badge" itemprop="articleSection" style="margin-bottom: 15px;"><%= safeBerita.category %></span>
        
        <!-- Header Artikel (Judul & Meta) -->
        <header>
            <!-- SMART COLOR: Adaptif hitam pekat di tema Light, putih bersinar di tema Dark -->
            <h1 itemprop="headline" class="detail-title" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin-bottom: 15px; color: var(--theme-heading); line-height: 1.3; font-weight: 800;">
                <%= safeBerita.title %>
            </h1>
            
            <div style="display:flex; align-items:center; gap:15px; color: var(--theme-muted); font-size:0.9rem; margin-bottom:30px; border-bottom:1px solid var(--theme-glass-border); padding-bottom:20px; flex-wrap: wrap;">
                <span style="display:flex; align-items:center; gap:5px;">
                    <i data-lucide="calendar" style="width:16px;"></i> 
                    <time itemprop="datePublished" datetime="<%= safeBerita.date %>"><%= safeBerita.date %></time>
                </span>
                <span itemprop="author" itemscope itemtype="https://schema.org/Organization" style="display:flex; align-items:center; gap:5px;">
                    <i data-lucide="user" style="width:16px;"></i> 
                    <span itemprop="name">Admin HMI KomKGUMI</span>
                </span>
            </div>
        </header>

        <!-- Gambar Utama Artikel -->
        <div class="detail-img-wrapper">
            <img itemprop="image" src="<%= safeBerita.image %>" alt="Cover Berita: <%= safeBerita.title %>" onerror="this.src='/img/logo-hmikomkgumi.png'">
        </div>

        <!-- Isi/Konten Utama Artikel (Smart Color Kontras) -->
        <div class="rich-text-content" itemprop="articleBody" style="color: var(--theme-text);">
            <%- safeBerita.content %>
        </div>

        <!-- ==============================================================
             UPGRADE: TOMBOL BAGIKAN NATIVE WEB SHARE API (PERSIS GAMBAR 1)
             Ditempatkan di bawah teks isi berita tanpa tombol salin
        ============================================================== -->
        <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--theme-glass-border); display: flex; justify-content: flex-end;">
            <button type="button" 
                    onclick="triggerNativeShare()" 
                    class="btn btn-secondary" 
                    style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 10px 20px; border-radius: 12px; cursor: pointer;">
                <i data-lucide="share-2" style="width: 18px; height: 18px;"></i>
                <span>Bagikan</span>
            </button>
        </div>

        <!-- Dokumentasi Tambahan -->
        <% if(safeBerita.photos && safeBerita.photos.length > 0) { %>
            <h3 style="margin-bottom: 20px; border-top: 1px solid var(--theme-glass-border); padding-top: 30px; color: var(--theme-heading);">Dokumentasi Tambahan</h3>
            <div class="grid-2" style="gap: 15px;">
                <% safeBerita.photos.forEach(photo => { %>
                    <div style="width: 100%; height: 200px; overflow: hidden; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: 1px solid var(--theme-glass-border);">
                        <img itemprop="image" src="<%= photo.url %>" alt="Dokumentasi Tambahan: <%= safeBerita.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                    </div>
                <% }) %>
            </div>
        <% } %>

    </article>

    <!-- ==============================================================
         SUPER BIG UPGRADE: DASHBOARD ANALYTICS WIDGET
         (STRUKTUR & CLASS PERSIS INDEX.EJS / GAMBAR 1)
    ============================================================== -->
    <section class="analytics-section" aria-label="Statistik Kunjungan Website" style="margin-top: 50px;">
        <div class="analytics-grid">
            <div class="analytic-card">
                <h4 class="analytic-title">VIEWS TODAY</h4>
                <div class="analytic-value stat-today" id="val-today">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">THIS WEEK</h4>
                <div class="analytic-value stat-week" id="val-week">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
            <div class="analytic-card">
                <h4 class="analytic-title">TOTAL VIEWS</h4>
                <div class="analytic-value stat-total" id="val-total">
                    <i data-lucide="loader-2" class="spin-icon"></i>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ==============================================================
     LOGIKA NATIVE SHARE & GOOGLE APPS SCRIPT ANALYTICS (PERSIS INDEX.EJS)
============================================================== -->
<script>
    // FUNGSI TRIGGER NATIVE WEB SHARE API (MEMANGGIL SYSTEM SHARE SHEET SEPERTI GAMBAR 1)
    async function triggerNativeShare() {
        const shareData = {
            title: <%- JSON.stringify(safeBerita.title) %>,
            text: <%- JSON.stringify(cleanDesc) %>,
            url: window.location.href
        };

        if (navigator.share) {
            try {
                await navigator.share(shareData);
            } catch (err) {
                // Pengguna membatalkan dialog share (AbortError)
            }
        } else {
            // Fallback halus tanpa tombol tambahan jika peramban tidak mendukung Web Share API
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
            }
        }
    }

    // SCRIPT PENGGERAK API GOOGLE APPS SCRIPT (PERSIS INDEX.EJS)
    document.addEventListener('DOMContentLoaded', () => {
        const GAS_URL = "https://script.google.com/macros/s/AKfycbw8MA9YGFK3SIAXhIZAF9m1J4eOGf9LGQD-j4xXjvVSaQ826JrqeEKApPcKJWfJxw/exec";

        let currentStats = { today: -1, week: -1, total: -1 };

        function animateValue(obj, start, end, duration) {
            if (start === end) return; 
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString('id-ID'); 
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        function updateUI(data, speed) {
            if(data.today !== undefined && data.today !== currentStats.today) {
                animateValue(document.getElementById('val-today'), Math.max(0, currentStats.today), data.today, speed);
                currentStats.today = data.today;
            }
            if(data.week !== undefined && data.week !== currentStats.week) {
                animateValue(document.getElementById('val-week'), Math.max(0, currentStats.week), data.week, speed);
                currentStats.week = data.week;
            }
            if(data.total !== undefined && data.total !== currentStats.total) {
                animateValue(document.getElementById('val-total'), Math.max(0, currentStats.total), data.total, speed);
                currentStats.total = data.total;
            }
        }

        // TAHAP 1: FAST FETCH (Memuat data dalam milidetik)
        async function fastFetchData() {
            try {
                const response = await fetch(GAS_URL + "?t=" + new Date().getTime());
                const textResponse = await response.text(); 
                
                try {
                    const data = JSON.parse(textResponse);
                    updateUI(data, 1000);
                } catch (jsonErr) {
                    console.warn("GAS Redirect/CORS Error, menggunakan fallback UI.");
                    setFallbackUI();
                }
            } catch (err) {
                console.warn("Koneksi ke GAS lambat/gagal.", err);
            }
        }

        // TAHAP 2: SILENT POST (Merekam IP Pengunjung di Latar Belakang)
        async function recordVisitPost() {
            try {
                const ipResponse = await fetch('https://api.ipify.org?format=json');
                const ipData = await ipResponse.json();
                const clientIP = ipData.ip || 'Unknown';

                const response = await fetch(GAS_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({ ip: clientIP })
                });

                const textResponse = await response.text(); 
                
                try {
                    const data = JSON.parse(textResponse);
                    if(data.status === "success") {
                        updateUI(data, 500);
                    }
                } catch (jsonErr) {
                    // Berjalan secara silent
                }
            } catch (error) {
                // Berjalan secara silent
            }
        }

        function setFallbackUI() {
            if(currentStats.today === -1) {
                document.getElementById('val-today').innerHTML = "-";
                document.getElementById('val-week').innerHTML = "-";
                document.getElementById('val-total').innerHTML = "-";
            }
        }

        fastFetchData();

        setTimeout(() => { 
            recordVisitPost(); 
        }, 2000);

        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>

<%- include('partials/footer') %>
