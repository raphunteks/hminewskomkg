<script>
    // ==============================================================
    // 1. FITUR BAGIKAN NATIVE WEB SHARE API (PERSIS GAMBAR 1)
    // ==============================================================
    async function triggerNativeShare() {
        const shareData = {
            title: <%- JSON.stringify(safeBerita.title) %>,
            text: <%- JSON.stringify(cleanDesc) %>,
            url: window.location.href
        };

        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
            try {
                // Memunculkan native system share sheet (AirDrop, Pesan, Catatan, Salin, WA, dll.)
                await navigator.share(shareData);
            } catch (err) {
                if (err.name !== 'AbortError') {
                    copyArticleUrl(window.location.href);
                }
            }
        } else if (navigator.share) {
            try {
                await navigator.share(shareData);
            } catch (err) {
                if (err.name !== 'AbortError') {
                    copyArticleUrl(window.location.href);
                }
            }
        } else {
            // Fallback untuk browser desktop tanpa native share
            copyArticleUrl(window.location.href);
        }
    }

    // ==============================================================
    // 2. FITUR LIKE / SUKA PERSIS GAMBAR 1 (PERSISTEN LOCALSTORAGE)
    // ==============================================================
    function initArticleLike(articleId) {
        const key = 'article_liked_' + articleId;
        const countKey = 'article_like_count_' + articleId;
        let count = parseInt(localStorage.getItem(countKey) || '62', 10);
        const isLiked = localStorage.getItem(key) === 'true';

        updateLikeButtonUI(isLiked, count);
    }

    function toggleArticleLike(articleId) {
        const key = 'article_liked_' + articleId;
        const countKey = 'article_like_count_' + articleId;
        let count = parseInt(localStorage.getItem(countKey) || '62', 10);
        let isLiked = localStorage.getItem(key) === 'true';

        if (isLiked) {
            isLiked = false;
            count = Math.max(0, count - 1);
        } else {
            isLiked = true;
            count += 1;
        }

        localStorage.setItem(key, isLiked ? 'true' : 'false');
        localStorage.setItem(countKey, count.toString());
        updateLikeButtonUI(isLiked, count);
    }

    function updateLikeButtonUI(isLiked, count) {
        const btn = document.getElementById('btnLikeArticle');
        const icon = document.getElementById('iconHeart');
        const label = document.getElementById('labelLikeCount');

        if (!btn || !label) return;

        label.innerText = count + ' Suka';
        if (isLiked) {
            btn.classList.add('btn-liked');
            if (icon) icon.setAttribute('fill', '#ef4444');
        } else {
            btn.classList.remove('btn-liked');
            if (icon) icon.removeAttribute('fill');
        }
    }

    // ==============================================================
    // 3. SALIN TAUTAN DENGAN NOTIFIKASI
    // ==============================================================
    function copyArticleUrl(url) {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(url).then(() => {
                alert('Tautan artikel berhasil disalin!');
            }).catch(() => {
                prompt('Salin tautan artikel ini:', url);
            });
        } else {
            prompt('Salin tautan artikel ini:', url);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        initArticleLike('<%= safeBerita.id %>');
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>

